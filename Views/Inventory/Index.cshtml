@model List<ARROW_ARO_RICE.Models.InventoryStock>
@{
    ViewData["Title"] = "Warehouse & Inventory Management";
    Layout = "_AdminLayout";
    var warehouses = ViewBag.Warehouses as List<ARROW_ARO_RICE.Models.Warehouse> ?? new List<ARROW_ARO_RICE.Models.Warehouse>();
    var products = ViewBag.Products as List<ARROW_ARO_RICE.Models.Product> ?? new List<ARROW_ARO_RICE.Models.Product>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="font-serif text-dark mb-0">Storage & Processing Facilities</h5>
        <small class="text-muted">Manage global milling hubs, port warehouses, and inland storage godowns.</small>
    </div>
    <button type="button" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#addWarehouseModal">
        <i class="fa-solid fa-plus text-gold"></i> Add Warehouse Facility
    </button>
</div>

<!-- Warehouses Summary Cards -->
<div class="row g-3 mb-4">
    @foreach (var wh in warehouses)
    {
        var whTotalStock = wh.Stocks.Sum(s => s.QuantityMT);
        var pct = wh.CapacityMT > 0 ? (whTotalStock / wh.CapacityMT) * 100 : 0;
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-light text-dark border">@wh.Code</span>
                    <span class="badge bg-success bg-opacity-10 text-success">Active Warehouse</span>
                </div>
                <h5 class="font-serif text-dark mb-1">@wh.Name</h5>
                <p class="text-muted small mb-3"><i class="fa-solid fa-location-dot text-danger me-1"></i> @wh.City, @wh.State</p>

                <div class="d-flex justify-content-between align-items-center small mb-1">
                    <span class="text-muted">Stock Utilization</span>
                    <strong class="text-dark">@whTotalStock.ToString("N0") / @wh.CapacityMT.ToString("N0") MT</strong>
                </div>
                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="pt-2 border-top text-muted small d-flex justify-content-between align-items-center">
                    <div>
                        <span>Contact: @wh.ContactPerson</span> &bull; <span class="text-dark fw-semibold">@wh.Phone</span>
                    </div>
                    @if (whTotalStock == 0)
                    {
                        <form asp-action="DeleteWarehouse" method="post" class="d-inline" onsubmit="return confirm('Remove warehouse facility @wh.Name?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@wh.Id" />
                            <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete Warehouse">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Stock Ledger Table & Actions -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h5 class="font-serif text-dark mb-1">Live Stock Ledger by Warehouse</h5>
            <p class="text-muted small mb-0">Real-time inventory levels, batch identification, moisture test logs, and reserved export allocations.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#stockInModal">
                <i class="fa-solid fa-arrow-down-long"></i> Stock Inward (Receive)
            </button>
            <a asp-action="Transactions" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-clock-rotate-left"></i> Transaction Ledger
            </a>
            <a asp-action="Export" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-file-excel"></i> Export (CSV)
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Warehouse</th>
                    <th>Rice Variety</th>
                    <th>Batch Number</th>
                    <th>In-Stock (MT)</th>
                    <th>Reserved (MT)</th>
                    <th>Available (MT)</th>
                    <th>Moisture (%)</th>
                    <th>Packaging</th>
                    <th>Last Updated</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@s.Warehouse?.Name</td>
                        <td>
                            <div class="fw-semibold text-dark">@s.Product?.Name</div>
                            <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">@s.Product?.Code</span>
                        </td>
                        <td><span class="badge bg-dark bg-opacity-10 text-dark font-monospace">@s.BatchNumber</span></td>
                        <td class="fw-bold fs-6 text-dark">@s.QuantityMT.ToString("N1") MT</td>
                        <td class="text-warning fw-semibold">@s.ReservedMT.ToString("N1") MT</td>
                        <td class="fw-bold fs-6 text-success">@s.AvailableMT.ToString("N1") MT</td>
                        <td>
                            <span class="spec-pill @(s.MoistureTestedPercent > 12.5m ? "text-danger" : "text-success")">
                                @s.MoistureTestedPercent%
                            </span>
                        </td>
                        <td>@s.PackagingType</td>
                        <td class="text-muted">@s.LastUpdated.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-xs btn-outline-danger" 
                                        onclick="openStockOutModal(@s.Id, '@s.Product?.Name', '@s.Warehouse?.Name', @s.AvailableMT)">
                                    Dispatch
                                </button>
                                <form asp-action="DeleteStock" method="post" class="d-inline" onsubmit="return confirm('Permanently remove this stock batch?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-xs btn-outline-secondary" title="Delete Stock Entry">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Stock Inward Modal -->
<div class="modal fade" id="stockInModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white" style="background: linear-gradient(135deg, #091f13, #154e29) !important;">
                <h5 class="modal-title font-serif text-white">Record Inward Stock Arrival</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="StockIn" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Receiving Warehouse *</label>
                        <select name="warehouseId" class="form-select" required>
                            @foreach (var wh in warehouses)
                            {
                                <option value="@wh.Id">@wh.Name (@wh.City)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Rice Variety *</label>
                        <select name="productId" class="form-select" required>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Name (@p.Category)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Quantity (MT) *</label>
                            <input type="number" step="0.5" name="quantityMT" class="form-control" placeholder="e.g. 50" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Tested Moisture % *</label>
                            <input type="number" step="0.1" name="moisture" class="form-control" value="12.0" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Batch Number *</label>
                        <input type="text" name="batchNumber" class="form-control" placeholder="e.g. KRN-1121S-2604" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Packaging Type</label>
                        <input type="text" name="packagingType" class="form-control" value="50kg PP Bags" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Remarks / Source Mandi</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Procured from Taraori Mandi / Mill Processing line 2..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-3">Confirm Inward Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Stock Outward Modal -->
<div class="modal fade" id="stockOutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-serif text-white">Dispatch Cargo for Export</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="StockOut" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="outStockId" name="stockId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <div class="text-muted small">Variety & Warehouse:</div>
                        <div class="fw-bold fs-6 text-dark" id="outStockName"></div>
                        <div class="text-muted small" id="outWarehouseName"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Dispatch Quantity (MT) *</label>
                        <input type="number" step="0.5" id="outQuantity" name="quantityMT" class="form-control" required />
                        <small class="text-muted">Available: <span id="outMaxAvailable" class="fw-bold text-success"></span> MT</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reference Document / Sales Order / Container</label>
                        <input type="text" name="reference" class="form-control" placeholder="e.g. SO-2026-001 / Container MSKU7821941" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Dispatch Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Loaded on trailer for Mundra Port CFS..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm px-3">Confirm Dispatch</button>
                </div>
            </form>
        </div>
    </div>
<!-- Add Warehouse Modal -->
<div class="modal fade" id="addWarehouseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white" style="background: linear-gradient(135deg, #091f13, #154e29) !important;">
                <h5 class="modal-title font-serif text-white">Add Warehouse Storage Facility</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateWarehouse" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label small fw-semibold">Warehouse Name *</label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Mundra Port CFS Terminal 4" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Code</label>
                            <input type="text" name="code" class="form-control" placeholder="e.g. WH-MUN-02" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">City *</label>
                            <input type="text" name="city" class="form-control" placeholder="e.g. Mundra" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">State / Province *</label>
                            <input type="text" name="state" class="form-control" placeholder="e.g. Gujarat" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Address / Location</label>
                            <input type="text" name="location" class="form-control" placeholder="Plot No. 45, Port SEZ Road..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Total Capacity (MT) *</label>
                            <input type="number" step="100" name="capacityMT" class="form-control" value="5000" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Contact Person</label>
                            <input type="text" name="contactPerson" class="form-control" placeholder="Warehouse Manager" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Contact Phone / Mobile</label>
                            <input type="text" name="phone" class="form-control" placeholder="+91 98765 43210" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold btn-sm px-3">Create Facility</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openStockOutModal(stockId, productName, warehouseName, available) {
        document.getElementById('outStockId').value = stockId;
        document.getElementById('outStockName').innerText = productName;
        document.getElementById('outWarehouseName').innerText = warehouseName;
        document.getElementById('outMaxAvailable').innerText = available;
        var qtyInput = document.getElementById('outQuantity');
        qtyInput.max = available;
        qtyInput.value = Math.min(25, available);
        
        new bootstrap.Modal(document.getElementById('stockOutModal')).show();
    }
</script>
}
