@inject ARROW_ARO_RICE.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Premium Indian Basmati & Non-Basmati Rice Exporters";
    var featured = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
    var siteSettings = DbContext.WebsiteSettings.FirstOrDefault() ?? new ARROW_ARO_RICE.Models.WebsiteSetting();
}

<!-- Hero Section -->
<section class="hero-wrapper">
    <div class="container-xl position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-tagline">
                    <i class="fa-solid fa-earth-americas text-warning"></i> Govt. Recognized Star Export House
                </div>
                <h1 class="hero-title">
                    Exporting India’s Finest <span>Basmati & Non-Basmati</span> Rice Worldwide
                </h1>
                <p class="hero-lead">
                    Delivering farm-fresh, optical sortex cleaned, extra long grain Indian rice to international importers, hypermarkets, and institutional distributors across 45+ countries.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <button type="button" class="btn btn-gold btn-lg px-4" data-bs-toggle="modal" data-bs-target="#quickQuoteModal">
                        <i class="fa-solid fa-file-signature me-2"></i> Request Export Quotation
                    </button>
                    <a asp-action="Products" class="btn btn-outline-light btn-lg px-4">
                        <i class="fa-solid fa-wheat-awn me-2 text-warning"></i> View Rice Catalog
                    </a>
                    <a asp-action="DownloadBrochure" class="btn btn-outline-warning btn-lg px-3">
                        <i class="fa-solid fa-download me-1"></i> Profile
                    </a>
                </div>
                <!-- Trust Badges -->
                <div class="d-flex flex-wrap gap-4 pt-3 border-top border-white border-opacity-15 text-white-50 small">
                    <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-circle-check text-warning"></i> APEDA Registered</span>
                    <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-circle-check text-warning"></i> ISO 22000 & HACCP</span>
                    <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-circle-check text-warning"></i> 100% Sortex Cleaned</span>
                    <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-circle-check text-warning"></i> SGS Pre-Shipment Inspection</span>
                </div>
            </div>

            <!-- Quick Shipment Tracker Card -->
            <div class="col-lg-5">
                <div class="hero-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h4 class="text-white mb-0 font-serif fs-5"><i class="fa-solid fa-ship text-warning me-2"></i> Live Container Tracking</h4>
                        <span class="badge bg-warning text-dark text-uppercase">B2B Portal</span>
                    </div>
                    <p class="text-white-50 small mb-3">
                        Importers can track high-seas vessel voyages, Mundra/JNPT container movements, and customs clearances in real-time.
                    </p>
                    <div class="input-group mb-3">
                        <input type="text" id="homeTrackingInput" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="Enter B/L, Container or SH No..." value="MSKU7821941" />
                        <button class="btn btn-gold px-3" type="button" onclick="trackLiveShipment()">
                            <i class="fa-solid fa-magnifying-glass"></i> Track
                        </button>
                    </div>
                    <div class="d-flex justify-content-between text-white-50" style="font-size: 0.78rem;">
                        <span>Try Sample: <a href="javascript:void(0)" onclick="document.getElementById('homeTrackingInput').value='MSKU7821941'; trackLiveShipment();" class="text-warning text-decoration-none">MSKU7821941</a> or <a href="javascript:void(0)" onclick="document.getElementById('homeTrackingInput').value='BL-MND-DXB-98104'; trackLiveShipment();" class="text-warning text-decoration-none">BL-MND-DXB-98104</a></span>
                    </div>

                    <div id="trackingResultBox" class="mt-3 p-3 rounded bg-dark bg-opacity-75 border border-warning border-opacity-25 d-none">
                        <!-- Populated via AJAX -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Company Key Performance Metrics -->
<section class="py-5 bg-white border-bottom">
    <div class="container-xl">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-success mb-1">@(siteSettings.AnnualMillingCapacityMT > 0 ? siteSettings.AnnualMillingCapacityMT.ToString("N0") + "+" : "150,000+")</div>
                    <div class="text-uppercase fw-semibold text-muted small" style="letter-spacing: 1px;">MT Annual Milling</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-success mb-1">@(string.IsNullOrWhiteSpace(siteSettings.CountriesExported) ? "45+" : siteSettings.CountriesExported)</div>
                    <div class="text-uppercase fw-semibold text-muted small" style="letter-spacing: 1px;">Export Destinations</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-success mb-1">8.35mm+</div>
                    <div class="text-uppercase fw-semibold text-muted small" style="letter-spacing: 1px;">Average Grain Length (1121)</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-success mb-1">99.8%</div>
                    <div class="text-uppercase fw-semibold text-muted small" style="letter-spacing: 1px;">Sortex Purity Guarantee</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Rice Varieties -->
<section class="py-5 my-3">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5">
            <div>
                <span class="badge bg-success bg-opacity-10 text-success text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Exclusive Product Portfolio</span>
                <h2 class="fs-1 font-serif text-dark mb-2">Our Premium Rice Varieties</h2>
                <p class="text-muted mb-0">Processed in automated milling facilities conforming to US FDA, EU pesticide MRL and GCC SFDA standards.</p>
            </div>
            <a asp-action="Products" class="btn btn-outline-dark mt-3 mt-md-0">
                Explore All Varieties <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var prod in featured)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="product-card">
                        <div class="product-header">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="category-badge">@prod.Category</span>
                                <span class="text-white-50 small"><i class="fa-solid fa-barcode me-1"></i> @prod.Code</span>
                            </div>
                            <h4 class="text-white fs-5 font-serif mb-1">@prod.Name</h4>
                            <div class="text-warning small"><i class="fa-solid fa-certificate me-1"></i> @prod.ProcessingType</div>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="spec-pill"><i class="fa-solid fa-ruler-horizontal text-success me-1"></i> @prod.AverageLengthMm mm AGL</span>
                                <span class="spec-pill"><i class="fa-solid fa-droplet text-primary me-1"></i> @prod.MoistureMaxPercent% Moisture</span>
                                <span class="spec-pill"><i class="fa-solid fa-percent text-danger me-1"></i> @prod.BrokenMaxPercent% Broken</span>
                                <span class="spec-pill"><i class="fa-solid fa-wind text-warning me-1"></i> @prod.AromaGrade</span>
                            </div>

                            <p class="text-muted small mb-4 flex-grow-1">
                                @prod.Description
                            </p>

                            <div class="border-top pt-3 mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <div class="text-muted small">Indicative FOB Price</div>
                                        <div class="fs-5 fw-bold text-dark">$@prod.DefaultFobPricePerMT.ToString("N0") <span class="fs-6 fw-normal text-muted">/ MT</span></div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small">Minimum Order</div>
                                        <span class="badge bg-light text-dark border">@prod.MinOrderQuantityMT MT (1 FCL)</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="ProductDetail" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-success flex-grow-1">
                                        <i class="fa-solid fa-circle-info me-1"></i> Full Specs
                                    </a>
                                    <button type="button" class="btn btn-sm btn-gold flex-grow-1" 
                                            onclick="openInquiryForProduct(@prod.Id, '@prod.Name', @prod.MinOrderQuantityMT)">
                                        <i class="fa-solid fa-paper-plane me-1"></i> Inquire
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Choose ARROW ARO RICE -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container-xl">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-warning bg-opacity-10 text-dark text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Our Competitive Advantage</span>
            <h2 class="fs-1 font-serif text-dark mb-2">Why Global Importers Partner With Us</h2>
            <p class="text-muted">Over two decades of precision processing, transparent pricing, and punctual maritime dispatch.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-seedling"></i>
                    </div>
                    <h4 class="fs-5 mb-2">Direct Himalayan Farmer Sourcing</h4>
                    <p class="text-muted small mb-0">Contract farming partnerships across Punjab and Haryana ensuring 100% authentic seed pedigree, non-GMO cultivation, and complete traceability from field to bag.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                    <h4 class="fs-5 mb-2">State-of-the-Art Optical Sortex</h4>
                    <p class="text-muted small mb-0">Multi-stage Buhler Sortex optical color sorters, advanced destoners, metal detectors, and computer-controlled parboiling plants yielding uniform grain color and zero foreign matter.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h4 class="fs-5 mb-2">Private Label & Custom Packaging</h4>
                    <p class="text-muted small mb-0">Complete OEM packaging in BOPP bags, Non-Woven sacks, Jute bags, and premium retail pouches (1kg to 50kg) custom printed with buyer’s private brand, logos, and regional nutrition labeling.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-flask-vial"></i>
                    </div>
                    <h4 class="fs-5 mb-2">Strict Laboratory QA & SGS Inspection</h4>
                    <p class="text-muted small mb-0">Every consignment is analyzed in our in-house lab for grain elongation, moisture, and cooking test. Verified by independent global inspectors (SGS, Bureau Veritas, Intertek) prior to container sealing.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-anchor"></i>
                    </div>
                    <h4 class="fs-5 mb-2">Strategic Port Operations (Mundra & JNPT)</h4>
                    <p class="text-muted small mb-0">Dedicated CFS warehousing at Mundra Port and Nhava Sheva (Mumbai). Fast customs clearance, vessel stuffing, and prioritized shipping lines (Maersk, MSC, CMA CGM) ensuring minimal transit delays.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-handshake-simple"></i>
                    </div>
                    <h4 class="fs-5 mb-2">Flexible IncoTerms & Trade Finance</h4>
                    <p class="text-muted small mb-0">FOB, CIF, and CFR trade execution. Support for international payment instruments including Irrevocable Letters of Credit (LC at Sight), CAD via prime banks, and Wire Transfer (T/T).</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Global Export Ports & Destinations Showcase -->
<section class="py-5" style="background: linear-gradient(145deg, #091f13 0%, #0f351e 100%); color: #ffffff;">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge bg-warning text-dark text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Worldwide Maritime Network</span>
                <h2 class="fs-1 font-serif text-white mb-3">Exporting to 45+ Ports Worldwide</h2>
                <p class="text-white-50 mb-4">
                    ARROW ARO RICE maintains continuous sea route dispatches to key consumer and distribution hubs across the Middle East, Europe, North America, Africa, and Southeast Asia.
                </p>
                
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-white bg-opacity-10 rounded border border-white border-opacity-10">
                            <h5 class="text-warning mb-1"><i class="fa-solid fa-location-dot me-1"></i> Middle East & Gulf</h5>
                            <p class="small text-white-75 mb-0">Jebel Ali (Dubai), Jeddah Islamic Port, Dammam, Shuwaikh (Kuwait), Hamad Port (Qatar), Muscat (Oman)</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-white bg-opacity-10 rounded border border-white border-opacity-10">
                            <h5 class="text-warning mb-1"><i class="fa-solid fa-location-dot me-1"></i> Europe & UK</h5>
                            <p class="small text-white-75 mb-0">Port of Rotterdam, Hamburg, Felixstowe, Antwerp, Le Havre, Mersin (Turkey)</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-white bg-opacity-10 rounded border border-white border-opacity-10">
                            <h5 class="text-warning mb-1"><i class="fa-solid fa-location-dot me-1"></i> North America</h5>
                            <p class="small text-white-75 mb-0">Houston (USHOU), New York/New Jersey, Long Beach, Vancouver, Montreal</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-white bg-opacity-10 rounded border border-white border-opacity-10">
                            <h5 class="text-warning mb-1"><i class="fa-solid fa-location-dot me-1"></i> Asia & Africa</h5>
                            <p class="small text-white-75 mb-0">Singapore, Port Klang (Malaysia), Alexandria, Durban, Mombasa, Chittagong</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="p-4 bg-white text-dark rounded-4 shadow-lg">
                    <h4 class="font-serif fw-bold text-dark mb-2">Request Destination CIF Freight</h4>
                    <p class="text-muted small mb-3">Our logistics desk will calculate ocean freight, container terminal handling (THC), and marine insurance to your discharge port.</p>
                    <form asp-action="SubmitInquiry" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="small fw-semibold">Your Name *</label>
                                <input type="text" name="FullName" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-6">
                                <label class="small fw-semibold">Company *</label>
                                <input type="text" name="CompanyName" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-6">
                                <label class="small fw-semibold">Business Email *</label>
                                <input type="email" name="Email" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-6">
                                <label class="small fw-semibold">Destination Port *</label>
                                <input type="text" name="DestinationPort" class="form-control form-control-sm" placeholder="e.g. Jebel Ali" required />
                            </div>
                            <div class="col-6">
                                <label class="small fw-semibold">Variety *</label>
                                <select name="RiceVariety" class="form-select form-select-sm">
                                    <option value="1121 Steam Basmati Rice">1121 Steam Basmati</option>
                                    <option value="1121 Golden Sella Basmati">1121 Golden Sella</option>
                                    <option value="1509 Steam Basmati">1509 Steam Basmati</option>
                                    <option value="Sona Masoori Raw Milled">Sona Masoori</option>
                                    <option value="IR64 Parboiled Rice">IR64 Parboiled</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="small fw-semibold">Quantity (MT) *</label>
