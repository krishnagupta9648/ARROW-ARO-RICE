@section Scripts {
<script>
    function openInquiryForProduct(productId, productName, moq) {
        var modalEl = document.getElementById('quickQuoteModal');
        var modal = new bootstrap.Modal(modalEl);
        
        var select = modalEl.querySelector('select[name="RiceVariety"]');
        if (select) {
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].text.includes(productName) || select.options[i].value.includes(productName)) {
                    select.selectedIndex = i;
                    break;
                }
            }
        }
        
        var qty = modalEl.querySelector('input[name="QuantityMT"]');
        if (qty && moq) {
            qty.value = moq;
        }
        
        modal.show();
    }

    async function trackLiveShipment() {
        var query = document.getElementById('homeTrackingInput').value.trim();
        var box = document.getElementById('trackingResultBox');
        if (!query) return;

        box.classList.remove('d-none');
        box.innerHTML = '<div class="text-center py-2 text-warning"><i class="fa-solid fa-spinner fa-spin me-2"></i> Querying maritime vessel radar...</div>';

        try {
            var response = await fetch('/api/track/' + encodeURIComponent(query));
            if (!response.ok) {
                box.innerHTML = '<div class="text-danger small"><i class="fa-solid fa-circle-exclamation me-1"></i> No active consignment found for <strong>' + query + '</strong>. Please verify your B/L or Container Number.</div>';
                return;
            }
            var data = await response.json();
            box.innerHTML = `
                <div class="text-white small">
                    <div class="d-flex justify-content-between border-bottom border-secondary pb-1 mb-2">
                        <strong class="text-warning"><i class="fa-solid fa-ship me-1"></i> ${data.shippingLine}</strong>
                        <span class="badge bg-success">${data.milestone}</span>
                    </div>
                    <div><strong>Vessel & Voyage:</strong> ${data.vesselName} (${data.voyageNumber})</div>
                    <div><strong>Containers:</strong> ${data.containerNumbers}</div>
                    <div><strong>Route:</strong> ${data.portOfLoading} &rarr; ${data.portOfDestination}</div>
                    <div><strong>Status:</strong> <span class="text-info">${data.statusDescription}</span></div>
                    <div class="mt-2 text-white-50" style="font-size: 0.72rem;">Docs verified: Commercial Invoice, Packing List, Phytosanitary & SGS Certificate</div>
                </div>
            `;
        } catch (e) {
            box.innerHTML = '<div class="text-danger small">Tracking service currently updating. Contact export desk on WhatsApp.</div>';
        }
    }
</script>
}
