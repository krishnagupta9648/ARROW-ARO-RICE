@{
    ViewData["Title"] = "About ARROW ARO RICE - Indian Rice Millers & Star Exporters";
}

<div class="py-5" style="background: linear-gradient(135deg, #091f13, #154e29); color: #fff;">
    <div class="container-xl">
        <span class="badge bg-warning text-dark text-uppercase px-3 py-2 rounded-pill mb-2">Heritage of Excellence Since 1998</span>
        <h1 class="display-4 font-serif text-white mb-3">About ARROW ARO RICE</h1>
        <p class="lead text-white-75 max-w-700">From the fertile plains of the Himalayan river basins to dining tables across the globe, delivering the pinnacle of Indian Basmati and Non-Basmati rice with uncompromised integrity.</p>
    </div>
</div>

<div class="container-xl py-5">
    <!-- Corporate Overview -->
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-success bg-opacity-10 text-success text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Company Overview</span>
            <h2 class="font-serif fs-1 text-dark mb-4">India's Premier Rice Milling & Star Export House</h2>
            <p class="text-muted">
                ARROW ARO RICE EXPORTS PVT LTD was founded in Taraori, Karnal (Haryana) — the epicentre of world-renowned Indian Basmati cultivation. Over the last two decades, the company has transformed from a regional paddy milling operation into a globally recognized star export powerhouse supplying premier importers, hypermarket chains, and food distributors across 45+ countries.
            </p>
            <p class="text-muted">
                Our operations encompass direct contract farmer procurement, automated parboiling and steam aging facilities, high-precision Buhler optical color sorting, temperature-controlled warehousing, and port-adjacent export logistics hubs at Mundra Port (Gujarat) and JNPT (Mumbai).
            </p>
            <div class="row g-3 pt-3">
                <div class="col-sm-6">
                    <div class="p-3 border rounded bg-white">
                        <div class="fw-bold fs-4 text-success mb-1">45,000 MT</div>
                        <div class="small text-muted">Annual Milling Capacity</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border rounded bg-white">
                        <div class="fw-bold fs-4 text-success mb-1">45+ Nations</div>
                        <div class="small text-muted">Export Dispatches</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="p-4 p-md-5 rounded-4 bg-white shadow-md border">
                <h4 class="font-serif text-dark mb-4"><i class="fa-solid fa-compass text-warning me-2"></i> Our Core Pillars</h4>
                <div class="d-flex gap-3 mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-bullseye fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fs-6 fw-bold text-dark mb-1">Our Mission</h5>
                        <p class="text-muted small mb-0">To deliver authentic, wholesome, sortex-clean Indian rice varieties to global dining tables while elevating farmer livelihoods and maintaining exemplary international food safety compliance.</p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <div class="rounded-circle bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-eye fs-4 text-dark"></i>
                    </div>
                    <div>
                        <h5 class="fs-6 fw-bold text-dark mb-1">Our Vision</h5>
                        <p class="text-muted small mb-0">To be the world’s most trusted and technologically advanced agricultural commodity export partner, celebrated for supreme grain quality, transparent trade execution, and punctual maritime delivery.</p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-gem fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fs-6 fw-bold text-dark mb-1">Export Integrity</h5>
                        <p class="text-muted small mb-0">Every grain is verified for minimum length, allowable broken percentage, and zero chemical adulteration with mandatory third-party container inspection (SGS/BV) before shipment.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Processing & Infrastructure -->
    <div class="py-5 border-top">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-warning bg-opacity-10 text-dark text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Technological Supremacy</span>
            <h2 class="fs-1 font-serif text-dark mb-2">World-Class Processing Infrastructure</h2>
            <p class="text-muted">Our fully automated manufacturing complex in Taraori, Karnal operates without manual touch to ensure zero contamination.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper"><i class="fa-solid fa-industry"></i></div>
                    <h4 class="fs-5 mb-2">Automated Steam & Parboiling Plants</h4>
                    <p class="text-muted small mb-0">Advanced stainless steel autoclaves and steam boilers lock essential vitamins and minerals into the starch matrix of each grain, producing consistent Golden Sella and Creamy Sella grades.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper"><i class="fa-solid fa-filter"></i></div>
                    <h4 class="fs-5 mb-2">Buhler Optical Color Sorters</h4>
                    <p class="text-muted small mb-0">Ultra-high-resolution cameras scan 100,000 grains per second, instantly ejecting discolored, immature, chalky, or damaged grains to achieve 99.8% pure sortex output.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper"><i class="fa-solid fa-temperature-arrow-down"></i></div>
                    <h4 class="fs-5 mb-2">Moisture-Controlled Silo Warehouses</h4>
                    <p class="text-muted small mb-0">45,000 MT capacity temperature-regulated silos and dehumidified godowns in Karnal, Mundra Port, and JNPT Mumbai prevent pest infestation and preserve natural Basmati aroma oils.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to action -->
    <div class="p-5 rounded-4 text-center text-white mt-5" style="background: linear-gradient(135deg, #091f13, #1e6b3b);">
        <h3 class="font-serif text-white fs-2 mb-3">Partner with India’s Most Reliable Rice Exporter</h3>
        <p class="text-white-75 mb-4 max-w-600 mx-auto">Get in touch with our international trade desk for FOB/CIF rates, free sample lots via air courier, or private brand packaging inquiries.</p>
        <div class="d-flex justify-content-center gap-3">
            <button type="button" class="btn btn-gold btn-lg px-4" data-bs-toggle="modal" data-bs-target="#quickQuoteModal">
                <i class="fa-solid fa-paper-plane me-2"></i> Request Formal Quotation
            </button>
            <a asp-action="Contact" class="btn btn-outline-light btn-lg px-4">
                <i class="fa-solid fa-phone me-2"></i> Contact Trade Desk
            </a>
        </div>
    </div>
</div>
