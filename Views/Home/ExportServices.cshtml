@{
    ViewData["Title"] = "Export Services - Private Labeling, Logistics & Documentation";
}

<div class="py-5" style="background: linear-gradient(135deg, #091f13, #154e29); color: #fff;">
    <div class="container-xl">
        <span class="badge bg-warning text-dark text-uppercase px-3 py-2 rounded-pill mb-2">End-to-End Export Solutions</span>
        <h1 class="display-4 font-serif text-white mb-2">Comprehensive Export Services</h1>
        <p class="lead text-white-75 max-w-700">From customized private label retail packaging to maritime freight booking, customs clearance, and statutory export documentation.</p>
    </div>
</div>

<div class="container-xl py-5">
    <!-- Service 1: Private Labeling & Packaging -->
    <div class="row align-items-center g-5 mb-5 pb-4 border-bottom">
        <div class="col-lg-6">
            <span class="badge bg-success bg-opacity-10 text-success text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">OEM / Private Brand</span>
            <h2 class="font-serif fs-1 text-dark mb-3">Private Labeling & Custom Packaging</h2>
            <p class="text-muted">
                We empower international supermarkets, wholesale distributors, and restaurant chains to market premium Indian rice under their own private brand name. Our in-house design and packaging division handles complete bag artwork, multi-language nutritional facts, barcodes, and regulatory compliance.
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-3 bg-white rounded border">
                        <h6 class="fw-bold mb-1"><i class="fa-solid fa-box text-warning me-1"></i> BOPP Laminated Bags</h6>
                        <p class="text-muted small mb-0">High-gloss photographic printing in 5kg, 10kg, 20kg & 40kg.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-white rounded border">
                        <h6 class="fw-bold mb-1"><i class="fa-solid fa-sack-dollar text-warning me-1"></i> Non-Woven Fabric Bags</h6>
                        <p class="text-muted small mb-0">Breathable eco-friendly bags with handles & zippers.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-white rounded border">
                        <h6 class="fw-bold mb-1"><i class="fa-solid fa-wheat-awn text-warning me-1"></i> Traditional Jute Bags</h6>
                        <p class="text-muted small mb-0">Natural hessian jute bags for premium vintage aroma retention.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-white rounded border">
                        <h6 class="fw-bold mb-1"><i class="fa-solid fa-cubes text-warning me-1"></i> Bulk PP Sacks & Liners</h6>
                        <p class="text-muted small mb-0">Heavy duty 25kg & 50kg polypropylene woven sacks.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="p-4 rounded-4 bg-light border shadow-sm">
                <h5 class="font-serif text-dark mb-3"><i class="fa-solid fa-check-circle text-success me-2"></i> Private Label Checklist</h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <span>Free Graphic Artwork Mockup & Cylinders</span>
                        <span class="badge bg-success">Included</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <span>Arabic & English Bilingual Translation (GCC / SFDA)</span>
                        <span class="badge bg-success">Compliant</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <span>FDA Nutrition Facts Panel & UPC/EAN Barcode</span>
                        <span class="badge bg-success">Certified</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <span>Minimum Order for Custom Printed Bags</span>
                        <span class="badge bg-dark">1 x 20' FCL</span>
                    </li>
                </ul>
                <div class="mt-4">
                    <button class="btn btn-emerald w-100" data-bs-toggle="modal" data-bs-target="#quickQuoteModal">
                        Inquire for Private Label
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Service 2: Maritime Logistics & IncoTerms -->
    <div class="row align-items-center g-5 mb-5 pb-4 border-bottom">
        <div class="col-lg-6 order-lg-2">
            <span class="badge bg-primary bg-opacity-10 text-primary text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Global Shipping</span>
            <h2 class="font-serif fs-1 text-dark mb-3">Maritime Freight & Container Logistics</h2>
            <p class="text-muted">
                Operating directly from Mundra Port (Gujarat) and Jawaharlal Nehru Port (JNPT Mumbai), we maintain priority service contracts with premier ocean carriers including Maersk Line, MSC, CMA CGM, and Hapag-Lloyd.
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-3 bg-white rounded border">
                        <div class="fw-bold text-dark mb-1">FOB Mundra / JNPT</div>
                        <p class="text-muted small mb-0">Loaded on board vessel at Indian port with all customs cleared and export duty paid.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-white rounded border">
                        <div class="fw-bold text-dark mb-1">CIF / CFR Destination</div>
                        <p class="text-muted small mb-0">Ocean freight prepaid to buyer's destination port with full marine insurance coverage.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 order-lg-1">
            <div class="p-4 rounded-4 bg-white border shadow-sm">
                <h5 class="font-serif text-dark mb-3"><i class="fa-solid fa-ship text-primary me-2"></i> Container Stuffing Specifications</h5>
                <table class="table table-sm small align-middle mb-0">
                    <tbody>
                        <tr>
                            <td class="fw-semibold">Container Type</td>
                            <td>Standard 20 Ft Dry Freight Container (20' FCL)</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Net Cargo Weight</td>
                            <td>Approx. 25.000 Metric Tons (25,000 Kg)</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">50 Kg Bag Stuffing</td>
                            <td>500 Bags per 20' Container (Hand-stuffed or Palletized)</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">40 Kg Bag Stuffing</td>
                            <td>625 Bags per 20' Container (Saudi SFDA Specification)</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Fumigation Method</td>
                            <td>Aluminum Phosphide / Methyl Bromide with 48h aeration</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Desiccant Bags</td>
                            <td>Container dry-pole silica gel bags to prevent sweat</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Service 3: Third Party Inspection & Export Documents -->
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge bg-warning bg-opacity-15 text-dark text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Documentation & Inspection</span>
            <h2 class="font-serif fs-1 text-dark mb-3">Statutory Export Documentation & SGS Inspection</h2>
            <p class="text-muted">
                International trade requires absolute documentary precision. Our dedicated documentation team manages the complete dossier required for overseas customs clearance and bank negotiation under Letter of Credit.
            </p>
            <ul class="list-unstyled text-muted small">
                <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> <strong>Commercial Invoice & Packing List:</strong> Certified copies indicating net/gross weights and bag counts.</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> <strong>Certificate of Origin:</strong> Issued by Chamber of Commerce & Export Inspection Council.</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> <strong>Phytosanitary Certificate:</strong> Issued by Directorate of Plant Protection, Govt. of India.</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> <strong>SGS / Bureau Veritas Certificate:</strong> Independent pre-shipment quality and container seal report.</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> <strong>Clean on Board Ocean Bill of Lading:</strong> 3/3 original negotiable bills.</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> <strong>Fumigation & Health Certificate:</strong> Confirming cargo free of live pests and fit for human consumption.</li>
            </ul>
        </div>

        <div class="col-lg-6">
            <div class="p-4 p-md-5 rounded-4 text-white" style="background: linear-gradient(135deg, #0c2b18, #166534);">
                <h4 class="font-serif text-white mb-3">Need Consignment Samples?</h4>
                <p class="text-white-75 small mb-4">We dispatch 1kg to 2kg laboratory samples of our current milling batches via DHL Express or FedEx Air courier directly to international buyer offices within 3 business days.</p>
                <button type="button" class="btn btn-gold w-100" data-bs-toggle="modal" data-bs-target="#quickQuoteModal">
                    <i class="fa-solid fa-box-archive me-1"></i> Request Air Courier Sample Lot
                </button>
            </div>
        </div>
    </div>
</div>
