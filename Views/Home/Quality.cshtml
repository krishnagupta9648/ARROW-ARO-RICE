@{
    ViewData["Title"] = "Quality Assurance & Certifications - APEDA, ISO 22000, HACCP";
}

<div class="py-5" style="background: linear-gradient(135deg, #091f13, #154e29); color: #fff;">
    <div class="container-xl">
        <span class="badge bg-warning text-dark text-uppercase px-3 py-2 rounded-pill mb-2">Zero Compromise Standard</span>
        <h1 class="display-4 font-serif text-white mb-2">Quality Assurance & Accreditations</h1>
        <p class="lead text-white-75 max-w-700">Committed to delivering pristine, non-GMO, chemically compliant rice meeting the most stringent global standards of the EU, US FDA, and GCC countries.</p>
    </div>
</div>

<div class="container-xl py-5">
    <!-- 5-Stage Quality Inspection Workflow -->
    <div class="text-center max-w-700 mx-auto mb-5">
        <span class="badge bg-success bg-opacity-10 text-success text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">Multi-Tier Defense</span>
        <h2 class="fs-1 font-serif text-dark mb-2">Our 5-Stage Quality Inspection Process</h2>
        <p class="text-muted">Rigorous testing protocols ensure only the purest grains make it into every export bag.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg col-md-6">
            <div class="p-4 bg-white rounded-4 border text-center h-100 shadow-sm">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 50px; height: 50px;">
                    <strong>01</strong>
                </div>
                <h5 class="fs-6 fw-bold text-dark mb-2">Farmer Field Inward</h5>
                <p class="text-muted small mb-0">Raw paddy sampled for moisture, grain maturity, and absence of prohibited pesticides before gate unloading.</p>
            </div>
        </div>

        <div class="col-lg col-md-6">
            <div class="p-4 bg-white rounded-4 border text-center h-100 shadow-sm">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 50px; height: 50px;">
                    <strong>02</strong>
                </div>
                <h5 class="fs-6 fw-bold text-dark mb-2">Destoning & Cleaning</h5>
                <p class="text-muted small mb-0">Multi-deck vibrating screens and rare-earth magnetic separators remove mud balls, weed seeds, and metallic particles.</p>
            </div>
        </div>

        <div class="col-lg col-md-6">
            <div class="p-4 bg-white rounded-4 border text-center h-100 shadow-sm">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 50px; height: 50px;">
                    <strong>03</strong>
                </div>
                <h5 class="fs-6 fw-bold text-dark mb-2">Buhler Sortex Scan</h5>
                <p class="text-muted small mb-0">High-speed optical cameras scan 100% of grains in free-fall, ejecting chalky, broken, yellowed, or damaged kernels.</p>
            </div>
        </div>

        <div class="col-lg col-md-6">
            <div class="p-4 bg-white rounded-4 border text-center h-100 shadow-sm">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 50px; height: 50px;">
                    <strong>04</strong>
                </div>
                <h5 class="fs-6 fw-bold text-dark mb-2">In-House Lab Release</h5>
                <p class="text-muted small mb-0">Laboratory test for raw grain length (AGL), moisture, cooking test, elongation ratio, and whiteness level.</p>
            </div>
        </div>

        <div class="col-lg col-md-6">
            <div class="p-4 bg-white rounded-4 border text-center h-100 shadow-sm">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 50px; height: 50px;">
                    <strong>05</strong>
                </div>
                <h5 class="fs-6 fw-bold text-dark mb-2">SGS Container Stuffing</h5>
                <p class="text-muted small mb-0">Independent international inspectors verify cargo condition, supervise bag loading, and affix tamper-proof customs seals.</p>
            </div>
        </div>
    </div>

    <!-- Official Certifications Showcase -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-5">
        <h3 class="font-serif text-dark mb-4">International Food Safety Accreditations</h3>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="fa-solid fa-award text-success fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">APEDA Registered</h6>
                            <small class="text-muted">Govt. of India Star Export House</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Authorized exporter of authentic Indian Basmati and Non-Basmati rice certified by the Ministry of Commerce & Industry.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="fa-solid fa-shield-halved text-primary fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">ISO 22000:2018</h6>
                            <small class="text-muted">Food Safety Management System</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Comprehensive food safety protocols governing the entire milling, steam processing, and packaging value chain.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="fa-solid fa-check-double text-warning fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">HACCP Certified</h6>
                            <small class="text-muted">Hazard Analysis Critical Control</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Strict hazard prevention eliminating biological, chemical, and physical foreign contaminants.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="fa-solid fa-moon text-success fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">100% Halal Certified</h6>
                            <small class="text-muted">Shariah Law Compliant</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Certified by international Islamic food accreditation boards for export to UAE, Saudi Arabia, Egypt, and Southeast Asia.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="fa-solid fa-building-columns text-info fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">US FDA Registered</h6>
                            <small class="text-muted">Prior Notice Facility</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Registered under the US Bioterrorism Act with active FDA facility numbers for seamless exports to the United States.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="fa-solid fa-certificate text-danger fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">FSSAI Approved</h6>
                            <small class="text-muted">Central Licensing Authority</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Conforming to Indian national standards for export grade food products with full traceability records.</p>
                </div>
            </div>
        </div>
    </div>
</div>
