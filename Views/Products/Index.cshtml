@model List<ARROW_ARO_RICE.Models.Product>
@{
    ViewData["Title"] = "Rice Catalog & Specifications Management";
    Layout = "_AdminLayout";
    string currentStatus = ViewBag.CurrentStatus as string ?? "all";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">Product Catalog & Export Specifications</h5>
            <p class="text-muted small mb-0">Configure active varieties, default FOB price benchmarks, moisture limits, and minimum order quantities.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Create" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="fa-solid fa-plus"></i> Add New Rice Variety
            </a>
        </div>
    </div>

    <!-- Status Tabs -->
    <div class="d-flex gap-2 mt-3 pt-3 border-top">
        <a asp-action="Index" asp-route-status="all" 
           class="btn btn-sm @(currentStatus == "all" ? "btn-dark" : "btn-light border") rounded-pill px-3">
            All Varieties <span class="badge @(currentStatus == "all" ? "bg-light text-dark" : "bg-secondary") ms-1">@ViewBag.TotalCount</span>
        </a>
        <a asp-action="Index" asp-route-status="active" 
           class="btn btn-sm @(currentStatus == "active" ? "btn-success" : "btn-light border") rounded-pill px-3">
            Active Catalog <span class="badge @(currentStatus == "active" ? "bg-white text-success" : "bg-success bg-opacity-25 text-success") ms-1">@ViewBag.ActiveCount</span>
        </a>
        <a asp-action="Index" asp-route-status="archived" 
           class="btn btn-sm @(currentStatus == "archived" ? "btn-danger" : "btn-light border") rounded-pill px-3">
            Archived / Hidden <span class="badge @(currentStatus == "archived" ? "bg-white text-danger" : "bg-danger bg-opacity-25 text-danger") ms-1">@ViewBag.ArchivedCount</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-seedling text-muted fs-1 mb-3 opacity-50"></i>
            <h6 class="text-dark fw-bold">No rice varieties found in this view</h6>
            <p class="text-muted small">Switch filters above or add a new rice variety to the export catalog.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Variety Name & Code</th>
                        <th>Category</th>
                        <th>Processing</th>
                        <th>Grain Length</th>
                        <th>Moisture</th>
                        <th>Broken</th>
                        <th>FOB Base Price</th>
                        <th>MOQ</th>
                        <th>Total Stock</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var totalStock = p.InventoryStocks.Sum(s => s.QuantityMT);
                        <tr class="@(!p.IsActive ? "bg-light bg-opacity-50" : "")">
                            <td>
                                <div class="fw-bold @(p.IsActive ? "text-dark" : "text-muted") fs-6">@p.Name</div>
                                <span class="badge bg-light text-muted border">@p.Code</span>
                            </td>
                            <td>
                                <span class="badge @(p.Category == "Basmati" ? "bg-success" : "bg-secondary")">@p.Category</span>
                            </td>
                            <td>@p.ProcessingType</td>
                            <td class="fw-bold text-success">@p.AverageLengthMm mm</td>
                            <td>@p.MoistureMaxPercent%</td>
                            <td>@p.BrokenMaxPercent%</td>
                            <td class="fw-bold text-dark">$@p.DefaultFobPricePerMT.ToString("N0") /MT</td>
                            <td>@p.MinOrderQuantityMT MT</td>
                            <td class="fw-bold @(totalStock > 0 ? "text-success" : "text-danger")">
                                @totalStock.ToString("N0") MT
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge @(p.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-25 text-dark")">
                                        @(p.IsActive ? "Active" : "Archived")
                                    </span>
                                    @if (p.IsFeatured && p.IsActive)
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-dark" style="font-size: 0.7rem;">
                                            <i class="fa-solid fa-star text-warning me-1"></i> Featured
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Edit Rice Variety">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </a>

                                    @if (p.IsActive)
                                    {
                                        <form asp-action="ToggleFeatured" asp-route-id="@p.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="@(p.IsFeatured ? "Unfeature from home" : "Feature on home")">
                                                <i class="fa-solid fa-star @(p.IsFeatured ? "text-warning" : "text-muted")"></i>
                                            </button>
                                        </form>

                                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="Archive / Hide from public catalog">
                                                <i class="fa-solid fa-box-archive"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @p.Name? If referenced in trade records it will be archived; otherwise permanently removed.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Product">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Reactivate Product in Catalog">
                                                <i class="fa-solid fa-rotate-left"></i> Restore
                                            </button>
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete @p.Name from database?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Permanently Delete">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
