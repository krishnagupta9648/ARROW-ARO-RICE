@model List<ARROW_ARO_RICE.Models.Inquiry>
@{
    ViewData["Title"] = "Buyer Inquiries & Leads Management";
    Layout = "_AdminLayout";
    var curStatus = ViewBag.SelectedStatus as string ?? "";
    var curPriority = ViewBag.SelectedPriority as string ?? "";
    var search = ViewBag.SearchTerm as string ?? "";
    var curPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">International Buyer Leads Pipeline</h5>
            <p class="text-muted small mb-0">Manage RFQs received from the export portal, track follow-ups, and convert leads into commercial quotations.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Export" asp-route-status="@curStatus" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-file-excel"></i> Export Excel (CSV)
            </a>
        </div>
    </div>

    <!-- Filter & Search Form -->
    <form asp-action="Index" method="get" class="row g-2 mt-3 pt-3 border-top">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<ARROW_ARO_RICE.Models.InquiryStatus>())
                {
                    <option value="@s" selected="@(curStatus == s.ToString())">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Priorities</option>
                @foreach (var p in Enum.GetValues<ARROW_ARO_RICE.Models.InquiryPriority>())
                {
                    <option value="@p" selected="@(curPriority == p.ToString())">@p Priority</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search by name, company, country or variety..." />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-emerald w-100">Filter</button>
            @if (!string.IsNullOrEmpty(curStatus) || !string.IsNullOrEmpty(curPriority) || !string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Inquiry No</th>
                    <th>Date</th>
                    <th>Buyer & Company</th>
                    <th>Country & Port</th>
                    <th>Variety & Volume</th>
                    <th>Priority</th>
                    <th>Assigned Rep</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No inquiries found matching current filters.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-success">@item.InquiryNumber</td>
                        <td class="text-muted" style="white-space: nowrap;">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(item.CompanyName) ? item.FullName : item.CompanyName)</div>
                            <div class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-envelope me-1"></i> @item.Email</div>
                        </td>
                        <td>
                            <div><span class="badge bg-light text-dark border">@item.Country</span></div>
                            <small class="text-muted">Port: @item.DestinationPort</small>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.RiceVariety</div>
                            <span class="badge bg-dark bg-opacity-10 text-dark">@item.QuantityMT MT (@item.IncoTerm)</span>
                        </td>
                        <td>
                            @if (item.Priority == ARROW_ARO_RICE.Models.InquiryPriority.Urgent)
                            {
                                <span class="badge bg-danger">Urgent</span>
                            }
                            else if (item.Priority == ARROW_ARO_RICE.Models.InquiryPriority.High)
                            {
                                <span class="badge bg-warning text-dark">High</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Normal</span>
                            }
                        </td>
                        <td>
                            <span class="text-muted">@(item.AssignedToUser?.FullName ?? "Unassigned")</span>
                        </td>
                        <td>
                            <span class="badge-status badge-@item.Status.ToString().ToLower()">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark" title="View Dossier">
                                    <i class="fa-solid fa-folder-open"></i>
                                </a>
                                @if (item.Status != ARROW_ARO_RICE.Models.InquiryStatus.Converted)
                                {
                                    <a asp-controller="Quotations" asp-action="Create" asp-route-inquiryId="@item.Id" class="btn btn-outline-warning text-dark" title="Create Quotation">
                                        <i class="fa-solid fa-file-invoice-dollar"></i>
                                    </a>
                                }
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this inquiry?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Delete Inquiry">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <div class="small text-muted">Page @curPage of @totalPages</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(curPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(curPage - 1)" asp-route-status="@curStatus" asp-route-priority="@curPriority" asp-route-search="@search">Previous</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == curPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@curStatus" asp-route-priority="@curPriority" asp-route-search="@search">@p</a>
                        </li>
                    }
                    <li class="page-item @(curPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(curPage + 1)" asp-route-status="@curStatus" asp-route-priority="@curPriority" asp-route-search="@search">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
