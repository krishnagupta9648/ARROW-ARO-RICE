@model List<ARROW_ARO_RICE.Models.OrderExpense>
@{
    ViewData["Title"] = "Order-Wise Export Expenses";
    Layout = "_AdminLayout";
    var salesOrders = ViewBag.SalesOrders as List<ARROW_ARO_RICE.Models.SalesOrder> ?? new List<ARROW_ARO_RICE.Models.SalesOrder>();
    var selectedSoId = ViewBag.SelectedSalesOrderId as int?;
    var totalExpenses = Model.Sum(e => e.Amount);
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="kpi-card">
            <div class="kpi-label">Total Logged Export Expenses</div>
            <div class="kpi-value text-danger">$@totalExpenses.ToString("N0") <span class="fs-6 fw-normal text-muted">USD</span></div>
            <div class="small text-muted">Ocean freight, inland trailers, CHA customs, inspection & fumigation</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="kpi-card d-flex flex-column justify-content-between">
            <div class="kpi-label">Order Expense Ledger</div>
            <div class="small text-muted mb-2">Track real cost components per export consignment to evaluate true profitability.</div>
            <button type="button" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1 w-auto" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                <i class="fa-solid fa-plus"></i> Record Order Expense
            </button>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">Export Expense Breakdown</h5>
            <p class="text-muted small mb-0">Select a specific sales order or review across all active trade operations.</p>
        </div>

        <form asp-action="Expenses" method="get" class="d-flex gap-2">
            <select name="salesOrderId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- All Export Orders --</option>
                @foreach (var so in salesOrders)
                {
                    <option value="@so.Id" selected="@(selectedSoId == so.Id)">@so.OrderNumber - @so.Customer?.CompanyName</option>
                }
            </select>
            @if (selectedSoId.HasValue)
            {
                <a asp-action="Expenses" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<!-- Expenses Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Sales Order</th>
                    <th>Expense Category</th>
                    <th>Payee / Vendor</th>
                    <th>Invoice / Receipt Ref</th>
                    <th>Amount (USD)</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No expenses recorded.</td>
                    </tr>
                }
                @foreach (var exp in Model)
                {
                    <tr>
                        <td class="text-muted">@exp.ExpenseDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <strong class="text-dark">@exp.SalesOrder?.OrderNumber</strong>
                            <div class="text-muted" style="font-size: 0.72rem;">@exp.SalesOrder?.Customer?.CompanyName</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@exp.Category</span></td>
                        <td class="fw-semibold">@exp.VendorOrPayee</td>
                        <td class="font-monospace">@(exp.InvoiceOrReceiptNumber ?? "N/A")</td>
                        <td class="fw-bold fs-6 text-danger">$@exp.Amount.ToString("N2")</td>
                        <td class="text-muted small">@exp.Remarks</td>
                        <td class="text-end">
                            <form asp-action="DeleteExpense" method="post" class="d-inline" onsubmit="return confirm('Permanently remove this expense entry?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@exp.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Expense">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add Expense -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white" style="background: linear-gradient(135deg, #091f13, #154e29) !important;">
                <h5 class="modal-title font-serif text-white">Record Export Consignment Expense</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddExpense" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Sales Order *</label>
                        <select name="salesOrderId" class="form-select" required>
                            @foreach (var so in salesOrders)
                            {
                                <option value="@so.Id">@so.OrderNumber - @so.Customer?.CompanyName (@so.PortOfDestination)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Expense Category *</label>
                        <select name="category" class="form-select" required>
                            @foreach (var cat in Enum.GetValues<ARROW_ARO_RICE.Models.ExpenseCategory>())
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Expense Amount (USD) *</label>
                        <input type="number" step="10" name="amount" class="form-control" placeholder="e.g. 1500" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Payee / Vendor Name *</label>
                        <input type="text" name="vendorOrPayee" class="form-control" placeholder="e.g. Maersk Shipping Line / Mundra Port CHA" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Vendor Invoice / Receipt Ref</label>
                        <input type="text" name="invoiceOrReceiptNumber" class="form-control" placeholder="e.g. MAEU-INV-99214" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Remarks</label>
                        <textarea name="remarks" class="form-control" rows="2" placeholder="Ocean freight for 2 containers Mundra to Jebel Ali..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-3">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>
