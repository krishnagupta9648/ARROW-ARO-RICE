@model ARROW_ARO_RICE.Models.ViewModels.ProfitabilityReportViewModel
@{
    ViewData["Title"] = "Order-Wise Export Profitability & Margin Analytics";
    Layout = "_AdminLayout";
}

<!-- Profitability Summary KPI Tiles -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-label">Gross Export Revenue</div>
            <div class="kpi-value text-dark">$@Model.TotalRevenueUsd.ToString("N0")</div>
            <div class="small text-muted">Across confirmed trade orders</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-label">Procurement & Milling Cost</div>
            <div class="kpi-value text-secondary">$@Model.TotalProcurementCostUsd.ToString("N0")</div>
            <div class="small text-muted">Raw paddy, parboiling & packaging</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-label">Logistics, Freight & CHA</div>
            <div class="kpi-value text-danger">$@Model.TotalLogisticsExpensesUsd.ToString("N0")</div>
            <div class="small text-muted">Ocean freight, SGS & port clearing</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card bg-success bg-opacity-10 border-success">
            <div class="kpi-label text-success">Net Profit Margin</div>
            <div class="kpi-value text-success">$@Model.TotalNetProfitUsd.ToString("N0")</div>
            <div class="small fw-bold text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i> Overall Margin: @Model.OverallMarginPercent.ToString("N1")%</div>
        </div>
    </div>
</div>

<!-- Header & Export Action -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">Order-Wise Profitability Statement</h5>
            <p class="text-muted small mb-0">Consolidated financial analysis comparing FOB/CIF contractual revenue against procurement, processing, maritime logistics, and terminal handling expenses.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="ExportProfitability" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-file-excel"></i> Export Statement (CSV)
            </a>
            <button type="button" class="btn btn-sm btn-outline-dark" onclick="window.print()">
                <i class="fa-solid fa-print"></i> Print Report
            </button>
        </div>
    </div>
</div>

<!-- Detailed Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order No</th>
                    <th>Buyer / Importer</th>
                    <th>Country</th>
                    <th>Volume (MT)</th>
                    <th>Revenue (USD)</th>
                    <th>Procurement (USD)</th>
                    <th>Logistics & Expenses</th>
                    <th>Net Profit (USD)</th>
                    <th>Profit Margin (%)</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No orders available for profitability analysis.</td>
                    </tr>
                }
                @foreach (var ord in Model.Orders)
                {
                    <tr>
                        <td class="fw-bold">
                            <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@ord.OrderId" class="text-dark text-decoration-none">
                                @ord.OrderNumber
                            </a>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@ord.CustomerName</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@ord.Country</span></td>
                        <td class="fw-bold">@ord.QuantityMT.ToString("N1") MT</td>
                        <td class="fw-bold text-dark">$@ord.RevenueUsd.ToString("N0")</td>
                        <td class="text-muted">-$@ord.ProcurementCostUsd.ToString("N0")</td>
                        <td class="text-danger">-$@ord.LogisticsAndExpensesUsd.ToString("N0")</td>
                        <td class="fw-bold fs-6 text-success">$@ord.NetProfitUsd.ToString("N0")</td>
                        <td>
                            <span class="badge @(ord.ProfitMarginPercent >= 15 ? "bg-success" : (ord.ProfitMarginPercent >= 8 ? "bg-warning text-dark" : "bg-danger"))">
                                @ord.ProfitMarginPercent.ToString("N1")%
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold fs-6">
                    <td colspan="4" class="text-end">Consolidated Total:</td>
                    <td class="text-dark">$@Model.TotalRevenueUsd.ToString("N0")</td>
                    <td class="text-muted">-$@Model.TotalProcurementCostUsd.ToString("N0")</td>
                    <td class="text-danger">-$@Model.TotalLogisticsExpensesUsd.ToString("N0")</td>
                    <td class="text-success">$@Model.TotalNetProfitUsd.ToString("N0")</td>
                    <td><span class="badge bg-success">@Model.OverallMarginPercent.ToString("N1")%</span></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
