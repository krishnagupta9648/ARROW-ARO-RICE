<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARROW ARO RICE Admin & Export CRM</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Master Custom Styling -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <span class="brand-badge"><i class="fa-solid fa-wheat-awn"></i></span>
            <div>
                <div class="fw-bold fs-6 text-white text-uppercase" style="letter-spacing: 1px;">ARROW ARO</div>
                <div class="text-warning small" style="font-size: 0.72rem; letter-spacing: 0.5px;">EXPORT CRM & ERP</div>
            </div>
        </div>

        <div class="overflow-auto flex-grow-1 py-2">
            <!-- CORE -->
            <div class="nav-section-title">Core Management</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
               asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-gauge-high"></i> Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "ActivityLogs" ? "active" : "")" 
               asp-controller="Admin" asp-action="ActivityLogs">
                <i class="fa-solid fa-clock-rotate-left"></i> Audit & Activity Logs
            </a>

            <!-- CRM & SALES -->
            <div class="nav-section-title">CRM & Leads</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inquiries" ? "active" : "")" 
               asp-controller="Inquiries" asp-action="Index">
                <i class="fa-solid fa-envelope-open-text"></i> Buyer Inquiries / RFQ
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")" 
               asp-controller="Customers" asp-action="Index">
                <i class="fa-solid fa-users"></i> International Buyers
            </a>

            <!-- TRADING & ORDERS -->
            <div class="nav-section-title">Trade & Orders</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Quotations" ? "active" : "")" 
               asp-controller="Quotations" asp-action="Index">
                <i class="fa-solid fa-file-invoice-dollar"></i> Quotations (Proforma)
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SalesOrders" && ViewContext.RouteData.Values["Action"]?.ToString() != "PurchaseOrders" ? "active" : "")" 
               asp-controller="SalesOrders" asp-action="Index">
                <i class="fa-solid fa-box-archive"></i> Sales Orders
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "PurchaseOrders" ? "active" : "")" 
               asp-controller="SalesOrders" asp-action="PurchaseOrders">
                <i class="fa-solid fa-truck-ramp-box"></i> Procurement & POs
            </a>

            <!-- LOGISTICS & INVENTORY -->
            <div class="nav-section-title">Logistics & Warehouses</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")" 
               asp-controller="Products" asp-action="Index">
                <i class="fa-solid fa-seedling"></i> Rice Catalog & Specs
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
               asp-controller="Inventory" asp-action="Index">
                <i class="fa-solid fa-warehouse"></i> Warehouse Stocks
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" && ViewContext.RouteData.Values["Action"]?.ToString() == "Transactions" ? "active" : "")" 
               asp-controller="Inventory" asp-action="Transactions">
                <i class="fa-solid fa-right-left"></i> Stock Movement Ledger
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shipments" ? "active" : "")" 
               asp-controller="Shipments" asp-action="Index">
                <i class="fa-solid fa-ship"></i> Export Shipments
            </a>

            <!-- FINANCE & PROFITABILITY -->
            <div class="nav-section-title">Finance & Profitability</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["Action"]?.ToString() == "Invoices" ? "active" : "")" 
               asp-controller="Finance" asp-action="Invoices">
                <i class="fa-solid fa-receipt"></i> Commercial Invoices
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["Action"]?.ToString() == "Expenses" ? "active" : "")" 
               asp-controller="Finance" asp-action="Expenses">
                <i class="fa-solid fa-money-bill-wave"></i> Order-Wise Expenses
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Finance" && ViewContext.RouteData.Values["Action"]?.ToString() == "Profitability" ? "active" : "")" 
               asp-controller="Finance" asp-action="Profitability">
                <i class="fa-solid fa-chart-line"></i> Profitability Reports
            </a>

            <!-- SYSTEM & DATABASE -->
            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section-title">System & Database</div>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Database" ? "active" : "")" 
                   asp-controller="Database" asp-action="Index">
                    <i class="fa-solid fa-database text-warning"></i> Database Studio & Hub
                </a>
            }
        </div>

        <div class="p-3 border-top border-white border-opacity-10 bg-black bg-opacity-25">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="rounded-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.85rem;">
                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="overflow-hidden">
                    <div class="text-white small fw-bold text-truncate">@User.Identity?.Name</div>
                    <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger w-100 py-1" style="font-size: 0.8rem;">
                    <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Canvas -->
    <main class="admin-main">
        <!-- Top Executive Navbar -->
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-3">
                <h4 class="mb-0 fw-bold fs-5 text-dark">@ViewData["Title"]</h4>
                <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">| Rice Export Management System</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-1">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Public Website
                </a>
                <a asp-controller="Quotations" asp-action="Create" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1">
                    <i class="fa-solid fa-plus"></i> New Quotation
                </a>
            </div>
        </header>

        <!-- Notification Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Page View Body -->
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
