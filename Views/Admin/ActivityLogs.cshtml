@model List<ARROW_ARO_RICE.Models.ActivityLog>
@{
    ViewData["Title"] = "System Audit & Activity Logs";
    Layout = "_AdminLayout";
    var selectedModule = ViewBag.SelectedModule as string ?? "All";
    var search = ViewBag.SearchTerm as string ?? "";
    var curPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : Model.Count;
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h5 class="font-serif text-dark mb-0">System Activity & Audit Log Trail</h5>
                <span class="badge bg-emerald bg-opacity-10 text-emerald">@totalCount Total Events</span>
            </div>
            <p class="text-muted small mb-0">Immutable, chronological transaction record across RFQs, proforma quotes, purchase/sales orders, shipments & finances.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-arrow-left"></i> Dashboard
            </a>
            <button type="button" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1" onclick="window.print()">
                <i class="fa-solid fa-print"></i> Print Ledger
            </button>
        </div>
    </div>

    <!-- Quick Filter Toolbar -->
    <div class="mt-4 pt-3 border-top">
        <form asp-action="ActivityLogs" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Filter by Module</label>
                <select name="module" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="All" selected="@(selectedModule == "All")">All Modules</option>
                    <option value="Inquiry" selected="@(selectedModule == "Inquiry")">Inquiries / RFQ</option>
                    <option value="Quotation" selected="@(selectedModule == "Quotation")">Quotations</option>
                    <option value="SalesOrder" selected="@(selectedModule == "SalesOrder")">Sales Orders</option>
                    <option value="Shipment" selected="@(selectedModule == "Shipment")">Shipments</option>
                    <option value="Inventory" selected="@(selectedModule == "Inventory")">Warehouse & Inventory</option>
                    <option value="Finance" selected="@(selectedModule == "Finance")">Finance & Payments</option>
                    <option value="Administration" selected="@(selectedModule == "Administration")">Administration</option>
                    <option value="Product" selected="@(selectedModule == "Product")">Grain Catalog</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label small text-muted mb-1">Search Keywords</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Search by operator, action, voucher or remarks..." />
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-emerald px-3">Filter Records</button>
                @if (selectedModule != "All" || !string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="ActivityLogs" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 170px;">Timestamp (UTC)</th>
                    <th style="width: 150px;">User / Operator</th>
                    <th style="width: 130px;">Module</th>
                    <th style="width: 180px;">Action Type</th>
                    <th>Transaction Details</th>
                    <th style="width: 70px;" class="text-end">Inspect</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-clipboard-list fs-1 d-block mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-semibold text-dark">No Activity Logs Found</h6>
                            <p class="small text-muted mb-3">No audit records match your current filter criteria.</p>
                            <a asp-action="ActivityLogs" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        var badgeClass = log.Module switch
                        {
                            "Inquiry" => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
                            "Quotation" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                            "SalesOrder" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                            "Shipment" => "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25",
                            "Inventory" => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25",
                            "Finance" => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
                            "Administration" => "bg-dark bg-opacity-10 text-dark border border-dark border-opacity-25",
                            _ => "bg-light text-dark border"
                        };
                        <tr>
                            <td class="text-muted" style="white-space: nowrap;">
                                <i class="fa-regular fa-clock text-secondary me-1" style="font-size: 0.75rem;"></i>
                                @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td class="fw-semibold">
                                <span class="d-inline-flex align-items-center gap-1">
                                    <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-inline-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.7rem;">
                                        @(log.UserName.Length > 0 ? log.UserName.Substring(0, 1).ToUpper() : "U")
                                    </span>
                                    <span>@log.UserName</span>
                                </span>
                            </td>
                            <td><span class="badge @badgeClass">@log.Module</span></td>
                            <td class="fw-bold text-dark">@log.Action</td>
                            <td class="text-secondary">@log.Details</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem;" 
                                        onclick="inspectLog('@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")', '@log.UserName', '@log.Module', '@log.Action', '@log.Details.Replace("'", "\\'")')">
                                    <i class="fa-solid fa-eye text-muted"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mt-4 pt-3 border-top">
            <div class="small text-muted">Showing page @curPage of @totalPages (@totalCount total events)</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(curPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="ActivityLogs" asp-route-page="@(curPage - 1)" asp-route-module="@selectedModule" asp-route-search="@search">Previous</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == curPage ? "active" : "")">
                            <a class="page-link" asp-action="ActivityLogs" asp-route-page="@p" asp-route-module="@selectedModule" asp-route-search="@search">@p</a>
                        </li>
                    }
                    <li class="page-item @(curPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="ActivityLogs" asp-route-page="@(curPage + 1)" asp-route-module="@selectedModule" asp-route-search="@search">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Log Inspector Modal -->
<div class="modal fade" id="logInspectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h6 class="modal-title font-serif mb-0"><i class="fa-solid fa-file-shield me-2 text-warning"></i> Audit Transaction Record</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-4 text-muted">Timestamp:</dt>
                    <dd class="col-8 fw-semibold" id="detailTimestamp">-</dd>

                    <dt class="col-4 text-muted">Operator:</dt>
                    <dd class="col-8 fw-semibold" id="detailUser">-</dd>

                    <dt class="col-4 text-muted">Module:</dt>
                    <dd class="col-8" id="detailModule">-</dd>

                    <dt class="col-4 text-muted">Action:</dt>
                    <dd class="col-8 fw-bold text-success" id="detailAction">-</dd>

                    <dt class="col-12 text-muted mt-2">Full Transaction Details & Payload:</dt>
                    <dd class="col-12 mt-1">
                        <div class="p-3 bg-light rounded-3 border text-dark" id="detailDetails" style="white-space: pre-wrap; font-size: 0.85rem;">-</div>
                    </dd>
                </dl>
            </div>
            <div class="modal-footer bg-light border-0 py-2 px-4">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function inspectLog(timestamp, user, module, action, details) {
        document.getElementById('detailTimestamp').innerText = timestamp;
        document.getElementById('detailUser').innerText = user;
        document.getElementById('detailModule').innerText = module;
        document.getElementById('detailAction').innerText = action;
        document.getElementById('detailDetails').innerText = details;

        var el = document.getElementById('logInspectModal');
        if (el) {
            var modal = bootstrap.Modal.getOrCreateInstance(el);
            modal.show();
        }
    }
</script>
}
