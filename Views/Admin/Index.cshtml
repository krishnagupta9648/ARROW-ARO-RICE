@model ARROW_ARO_RICE.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Export & CRM Dashboard";
    Layout = "_AdminLayout";
}

<!-- Top 8 KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Total Inquiries (RFQ)</div>
                <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
            </div>
            <div class="kpi-value text-primary">@Model.TotalInquiries</div>
            <div class="small text-muted"><i class="fa-solid fa-arrow-trend-up text-success me-1"></i> Active Leads: <strong class="text-dark">@Model.ActiveLeads</strong></div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Quotations Pending</div>
                <div class="kpi-icon-box bg-warning bg-opacity-15 text-warning">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>
            <div class="kpi-value text-warning">@Model.QuotationsPending</div>
            <div class="small text-muted"><a asp-controller="Quotations" asp-action="Index" class="text-decoration-none text-muted">Review proforma quotes &rarr;</a></div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Confirmed Orders</div>
                <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-box-archive"></i>
                </div>
            </div>
            <div class="kpi-value text-success">@Model.ConfirmedOrders</div>
            <div class="small text-muted">In processing, packing & transit</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Shipments In Transit</div>
                <div class="kpi-icon-box bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-ship"></i>
                </div>
            </div>
            <div class="kpi-value text-info">@Model.ShipmentsInTransit</div>
            <div class="small text-muted"><a asp-controller="Shipments" asp-action="Index" class="text-decoration-none text-muted">Track maritime vessels &rarr;</a></div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Total Export Volume</div>
                <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-weight-hanging"></i>
                </div>
            </div>
            <div class="kpi-value text-dark">@Model.TotalSalesVolumeMT.ToString("N0") <span class="fs-6 fw-normal text-muted">MT</span></div>
            <div class="small text-muted">Shipped & booked consignments</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Export Sales Revenue</div>
                <div class="kpi-icon-box bg-warning bg-opacity-15 text-warning">
                    <i class="fa-solid fa-dollar-sign"></i>
                </div>
            </div>
            <div class="kpi-value text-dark">$@Model.TotalSalesRevenueUsd.ToString("N0")</div>
            <div class="small text-muted">Gross export contract value</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Outstanding Receivables</div>
                <div class="kpi-icon-box bg-danger bg-opacity-10 text-danger">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
            </div>
            <div class="kpi-value text-danger">$@Model.TotalReceivablesUsd.ToString("N0")</div>
            <div class="small text-muted">Balance against B/L scans & LCs</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="kpi-label">Warehouse Stock Available</div>
                <div class="kpi-icon-box bg-secondary bg-opacity-10 text-secondary">
                    <i class="fa-solid fa-warehouse"></i>
                </div>
            </div>
            <div class="kpi-value text-dark">@Model.TotalStockAvailableMT.ToString("N0") <span class="fs-6 fw-normal text-muted">MT</span></div>
            <div class="small text-muted">Across Karnal, Mundra & JNPT</div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white border-start border-4 border-success">
        <div class="card-body py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-2 px-3 fw-semibold">
                    <i class="fa-solid fa-database me-1"></i> Database Engine: SQLite 3 (Connected)
                </span>
                <span class="small text-muted">
                    19 Relational Tables &bull; Auto-Seeded Enterprise Dataset &bull; MySQL & SQL Server scripts ready
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Database" asp-action="Index" class="btn btn-sm btn-outline-success py-1 px-3">
                    <i class="fa-solid fa-sliders me-1"></i> Database Studio & SQL Hub &rarr;
                </a>
            </div>
        </div>
    </div>
}

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-chart-pie text-success me-2"></i> Inquiries by Destination Country</h5>
                <span class="badge bg-light text-muted border">Geographic Demand</span>
            </div>
            <div style="height: 250px;">
                <canvas id="countryChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-chart-column text-primary me-2"></i> Top Exported Varieties (MT)</h5>
                <span class="badge bg-light text-muted border">Product Volume</span>
            </div>
            <div style="height: 250px;">
                <canvas id="varietyChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Alerts (If Any) -->
@if (Model.LowStockAlerts.Any())
{
    <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation fs-4 text-warning"></i>
            <div>
                <strong>Inventory Reorder Warning:</strong> @Model.LowStockAlerts.Count warehouse stock lots have fallen below the configured reorder threshold.
            </div>
        </div>
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-sm btn-dark">View Stock Ledger</a>
    </div>
}

<!-- Recent Inquiries & Live Shipments Row -->
<div class="row g-4 mb-4">
    <!-- Recent Inquiries -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-inbox text-warning me-2"></i> Recent Buyer Inquiries (RFQ)</h5>
                <a asp-controller="Inquiries" asp-action="Index" class="btn btn-sm btn-outline-dark">View All</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Inquiry No</th>
                            <th>Buyer</th>
                            <th>Country</th>
                            <th>Variety</th>
                            <th>Volume</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inq in Model.RecentInquiries)
                        {
                            <tr>
                                <td class="fw-bold">@inq.InquiryNumber</td>
                                <td>
                                    <div>@(string.IsNullOrEmpty(inq.CompanyName) ? inq.FullName : inq.CompanyName)</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@inq.Email</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@inq.Country</span></td>
                                <td class="small text-truncate" style="max-width: 140px;">@inq.RiceVariety</td>
                                <td class="fw-bold">@inq.QuantityMT MT</td>
                                <td>
                                    <span class="badge-status badge-@inq.Status.ToString().ToLower()">
                                        @inq.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Inquiries" asp-action="Details" asp-route-id="@inq.Id" class="btn btn-xs btn-outline-success">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Active High-Seas Shipments -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-ship text-info me-2"></i> Active Export Shipments</h5>
                <a asp-controller="Shipments" asp-action="Index" class="btn btn-sm btn-outline-dark">Track All</a>
            </div>

            @if (!Model.ActiveShipments.Any())
            {
                <div class="text-center py-4 text-muted small">No active export shipments currently in transit.</div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var ship in Model.ActiveShipments)
                    {
                        <div class="p-3 rounded-3 border bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-dark">@ship.ShipmentNumber</strong>
                                <span class="badge-status badge-intransit">@ship.CurrentMilestone</span>
                            </div>
                            <div class="small text-muted mb-2">
                                <i class="fa-solid fa-anchor text-secondary me-1"></i> @ship.ShippingLine | <strong>@ship.VesselName (@ship.VoyageNumber)</strong>
                            </div>
                            <div class="small text-dark mb-2">
                                <strong>Route:</strong> @ship.PortOfLoading &rarr; <span class="text-success fw-bold">@ship.PortOfDestination</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-10 small">
                                <span class="text-muted" style="font-size: 0.75rem;">Containers: @ship.ContainerNumbers</span>
                                <a asp-controller="Shipments" asp-action="Details" asp-route-id="@ship.Id" class="text-decoration-none fw-bold text-success">
                                    Details &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- System Audit Feed & Recent Activity Logs -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
        <div>
            <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i> Live Audit Trail & Activity Logs</h5>
            <small class="text-muted">Real-time immutable audit feed across inquiries, trade orders, logistics & finances</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#fullAuditLogModal" id="btnViewFullAuditLog">
                <i class="fa-solid fa-clock-rotate-left"></i> View Full Audit Log
            </button>
            <a asp-controller="Admin" asp-action="ActivityLogs" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1" title="Open Dedicated Activity Logs Page">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Full Page
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 160px;">Timestamp</th>
                    <th style="width: 140px;">User</th>
                    <th style="width: 130px;">Module</th>
                    <th style="width: 180px;">Action</th>
                    <th>Transaction Details</th>
                    <th style="width: 70px;" class="text-end">Inspect</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentActivities == null || !Model.RecentActivities.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-clock-rotate-left fs-3 d-block mb-2 text-secondary opacity-50"></i>
                            No recent audit activities recorded yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var act in Model.RecentActivities)
                    {
                        var badgeClass = act.Module switch
                        {
                            "Inquiry" => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
                            "Quotation" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                            "SalesOrder" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                            "Shipment" => "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25",
                            "Inventory" => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25",
                            "Finance" => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
                            "Administration" => "bg-dark bg-opacity-10 text-dark border border-dark border-opacity-25",
                            _ => "bg-light text-dark border"
                        };
                        <tr>
                            <td class="text-muted" style="white-space: nowrap;">
                                <i class="fa-regular fa-clock text-secondary me-1" style="font-size: 0.75rem;"></i>
                                @act.Timestamp.ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td class="fw-semibold">
                                <span class="d-inline-flex align-items-center gap-1">
                                    <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-inline-flex align-items-center justify-content-center fw-bold" style="width: 22px; height: 22px; font-size: 0.7rem;">
                                        @(act.UserName.Length > 0 ? act.UserName.Substring(0, 1).ToUpper() : "U")
                                    </span>
                                    <span>@act.UserName</span>
                                </span>
                            </td>
                            <td><span class="badge @badgeClass">@act.Module</span></td>
                            <td class="fw-bold text-dark">@act.Action</td>
                            <td class="text-secondary">@act.Details</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem;" 
                                        onclick="inspectAuditLog('@act.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")', '@act.UserName', '@act.Module', '@act.Action', '@act.Details.Replace("'", "\\'")')">
                                    <i class="fa-solid fa-eye text-muted"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Complete System Audit Trail Modal -->
<div class="modal fade" id="fullAuditLogModal" tabindex="-1" aria-labelledby="fullAuditLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-light border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-emerald bg-opacity-10 text-emerald p-2 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-clock-rotate-left fs-6"></i>
                    </span>
                    <div>
                        <h5 class="modal-title font-serif text-dark fw-bold mb-0" id="fullAuditLogModalLabel">Full System Audit & Activity Log Trail</h5>
                        <small class="text-muted">Immutable export CRM event log &mdash; Showing <span id="modalAuditVisibleCount" class="fw-bold text-dark">@Model.AllActivities.Count</span> of @Model.AllActivities.Count total recorded events</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <!-- Live Search & Module Filter Toolbar -->
                <div class="p-3 bg-light rounded-3 mb-3 border">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" id="modalAuditSearch" class="form-control border-start-0" placeholder="Live search by user, action, details..." oninput="filterModalAuditLogs()" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select id="modalAuditModuleSelect" class="form-select form-select-sm" onchange="filterModalAuditLogs()">
                                <option value="All">All Modules</option>
                                <option value="Inquiry">Inquiries</option>
                                <option value="Quotation">Quotations</option>
                                <option value="SalesOrder">Sales Orders</option>
                                <option value="Shipment">Shipments</option>
                                <option value="Inventory">Inventory</option>
                                <option value="Finance">Finance</option>
                                <option value="Administration">Administration</option>
                                <option value="Product">Grain Catalog</option>
                            </select>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span class="small text-muted me-1">Quick Filters:</span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm audit-pill-btn active" data-mod="All" onclick="setAuditModuleFilter('All')">All</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm audit-pill-btn" data-mod="SalesOrder" onclick="setAuditModuleFilter('SalesOrder')">Orders</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm audit-pill-btn" data-mod="Shipment" onclick="setAuditModuleFilter('Shipment')">Shipments</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm audit-pill-btn" data-mod="Finance" onclick="setAuditModuleFilter('Finance')">Finance</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Audit Log Entries Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0" id="modalAuditTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 170px;">Timestamp</th>
                                <th style="width: 140px;">User</th>
                                <th style="width: 120px;">Module</th>
                                <th style="width: 180px;">Action</th>
                                <th>Transaction Details</th>
                                <th style="width: 70px;" class="text-end">Inspect</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AllActivities == null || !Model.AllActivities.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-clock-rotate-left fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                        No activity logs recorded yet in the database.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.AllActivities)
                                {
                                    var badgeClass = log.Module switch
                                    {
                                        "Inquiry" => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
                                        "Quotation" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                                        "SalesOrder" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                                        "Shipment" => "bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25",
                                        "Inventory" => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25",
                                        "Finance" => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
                                        "Administration" => "bg-dark bg-opacity-10 text-dark border border-dark border-opacity-25",
                                        _ => "bg-light text-dark border"
                                    };
                                    <tr class="audit-modal-row" data-module="@log.Module">
                                        <td class="text-muted" style="white-space: nowrap;">
                                            <i class="fa-regular fa-clock text-secondary me-1" style="font-size: 0.75rem;"></i>
                                            @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                        </td>
                                        <td class="fw-semibold">
                                            <span class="d-inline-flex align-items-center gap-1">
                                                <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-inline-flex align-items-center justify-content-center fw-bold" style="width: 22px; height: 22px; font-size: 0.7rem;">
                                                    @(log.UserName.Length > 0 ? log.UserName.Substring(0, 1).ToUpper() : "U")
                                                </span>
                                                <span>@log.UserName</span>
                                            </span>
                                        </td>
                                        <td><span class="badge @badgeClass">@log.Module</span></td>
                                        <td class="fw-bold text-dark">@log.Action</td>
                                        <td class="text-secondary">@log.Details</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem;" 
                                                    onclick="inspectAuditLog('@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")', '@log.UserName', '@log.Module', '@log.Action', '@log.Details.Replace("'", "\\'")')">
                                                <i class="fa-solid fa-eye text-muted"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div id="modalAuditEmptyState" class="text-center py-5 text-muted" style="display: none;">
                        <i class="fa-solid fa-filter-circle-xmark fs-2 d-block mb-2 text-secondary opacity-50"></i>
                        No audit log entries match your filter or search query.
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i> Cryptographically sequenced immutable audit records
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Admin" asp-action="ActivityLogs" class="btn btn-sm btn-emerald d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Full Page Ledger
                    </a>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Audit Log Item Inspector Modal -->
<div class="modal fade" id="auditInspectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h6 class="modal-title font-serif mb-0"><i class="fa-solid fa-file-shield me-2 text-warning"></i> Audit Transaction Record</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-4 text-muted">Timestamp:</dt>
                    <dd class="col-8 fw-semibold" id="inspectTimestamp">-</dd>

                    <dt class="col-4 text-muted">Operator:</dt>
                    <dd class="col-8 fw-semibold" id="inspectUser">-</dd>

                    <dt class="col-4 text-muted">Module:</dt>
                    <dd class="col-8" id="inspectModule">-</dd>

                    <dt class="col-4 text-muted">Action:</dt>
                    <dd class="col-8 fw-bold text-success" id="inspectAction">-</dd>

                    <dt class="col-12 text-muted mt-2">Full Transaction Details & Payload:</dt>
                    <dd class="col-12 mt-1">
                        <div class="p-3 bg-light rounded-3 border text-dark" id="inspectDetails" style="white-space: pre-wrap; font-size: 0.85rem;">-</div>
                    </dd>
                </dl>
            </div>
            <div class="modal-footer bg-light border-0 py-2 px-4">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Render Inquiries by Country Chart
        fetch('/api/dashboard/inquiries-by-country')
            .then(res => res.json())
            .then(data => {
                var labels = data.map(x => x.country);
                var values = data.map(x => x.count);
                new Chart(document.getElementById('countryChart'), {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: ['#124726', '#d4af37', '#0369a1', '#7c3aed', '#ea580c', '#059669'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } }
                        }
                    }
                });
            });

        // Render Variety Distribution Chart
        fetch('/api/dashboard/variety-distribution')
            .then(res => res.json())
            .then(data => {
                var labels = data.map(x => x.variety);
                var values = data.map(x => x.volumeMT);
                new Chart(document.getElementById('varietyChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Volume (MT)',
                            data: values,
                            backgroundColor: '#124726',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            });
    });

    // Client-side filtering for Audit Logs modal
    function filterModalAuditLogs() {
        var searchInput = document.getElementById('modalAuditSearch');
        var moduleSelect = document.getElementById('modalAuditModuleSelect');
        var search = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var module = moduleSelect ? moduleSelect.value : 'All';
        var rows = document.querySelectorAll('.audit-modal-row');
        var visibleCount = 0;

        rows.forEach(function (row) {
            var rowModule = row.getAttribute('data-module') || '';
            var rowText = row.innerText.toLowerCase();

            var matchesModule = (module === 'All' || rowModule === module);
            var matchesSearch = (!search || rowText.indexOf(search) !== -1);

            if (matchesModule && matchesSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        var emptyMsg = document.getElementById('modalAuditEmptyState');
        if (emptyMsg) {
            emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
        }
        var countBadge = document.getElementById('modalAuditVisibleCount');
        if (countBadge) {
            countBadge.innerText = visibleCount;
        }
    }

    function setAuditModuleFilter(mod) {
        var moduleSelect = document.getElementById('modalAuditModuleSelect');
        if (moduleSelect) {
            moduleSelect.value = mod;
        }
        document.querySelectorAll('.audit-pill-btn').forEach(function(b) {
            if (b.getAttribute('data-mod') === mod) {
                b.classList.remove('btn-outline-secondary');
                b.classList.add('btn-dark');
                b.classList.add('active');
            } else {
                b.classList.remove('btn-dark');
                b.classList.remove('active');
                b.classList.add('btn-outline-secondary');
            }
        });
        filterModalAuditLogs();
    }

    function inspectAuditLog(timestamp, user, module, action, details) {
        var elTime = document.getElementById('inspectTimestamp');
        var elUser = document.getElementById('inspectUser');
        var elMod = document.getElementById('inspectModule');
        var elAct = document.getElementById('inspectAction');
        var elDet = document.getElementById('inspectDetails');

        if (elTime) elTime.innerText = timestamp;
        if (elUser) elUser.innerText = user;
        if (elMod) elMod.innerText = module;
        if (elAct) elAct.innerText = action;
        if (elDet) elDet.innerText = details;

        var inspectEl = document.getElementById('auditInspectModal');
        if (inspectEl) {
            var inspectModal = bootstrap.Modal.getOrCreateInstance(inspectEl);
            inspectModal.show();
        }
    }
</script>
}
