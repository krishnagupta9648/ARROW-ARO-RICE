@model List<ARROW_ARO_RICE.Models.Customer>
@{
    ViewData["Title"] = "International Buyers Database";
    Layout = "_AdminLayout";
    var countries = ViewBag.Countries as List<string> ?? new List<string>();
    var selectedCountry = ViewBag.SelectedCountry as string ?? "All";
    var search = ViewBag.SearchTerm as string ?? "";
    var curPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">International Buyers & Importers Directory</h5>
            <p class="text-muted small mb-0">Manage accredited overseas buyers, credit terms, trade records, and VAT/import licenses.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Export" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-file-excel"></i> Export Buyers (CSV)
            </a>
            <a asp-action="Create" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-user-plus"></i> Register New Buyer
            </a>
        </div>
    </div>

    <!-- Filter Form -->
    <form asp-action="Index" method="get" class="row g-2 mt-3 pt-3 border-top">
        <div class="col-md-4">
            <select name="country" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="All" selected="@(selectedCountry == "All")">All Importer Countries</option>
                @foreach (var c in countries)
                {
                    <option value="@c" selected="@(selectedCountry == c)">@c</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search by company name, contact person, email or port..." />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-emerald w-100">Filter</button>
            @if (selectedCountry != "All" || !string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Buyers Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Company Name</th>
                    <th>Contact Person</th>
                    <th>Country & City</th>
                    <th>Contact Channels</th>
                    <th>Preferred Port</th>
                    <th>Payment Terms</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No buyers found matching current search filters.</td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark fs-6">@c.CompanyName</div>
                            <span class="text-muted" style="font-size: 0.72rem;">VAT: @(string.IsNullOrEmpty(c.TaxOrVatNumber) ? "N/A" : c.TaxOrVatNumber)</span>
                        </td>
                        <td class="fw-semibold">@c.ContactPerson</td>
                        <td>
                            <div><span class="badge bg-light text-dark border">@c.Country</span></div>
                            <small class="text-muted">@c.City</small>
                        </td>
                        <td>
                            <div><i class="fa-solid fa-envelope text-muted me-1"></i> @c.Email</div>
                            @if (!string.IsNullOrEmpty(c.WhatsApp))
                            {
                                <div class="text-success"><i class="fa-brands fa-whatsapp me-1"></i> @c.WhatsApp</div>
                            }
                        </td>
                        <td>
                            <span class="fw-semibold text-secondary">@(c.PreferredDestinationPort ?? "Not specified")</span>
                        </td>
                        <td>
                            <span class="small text-muted">@c.PaymentTerms</span>
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold">@c.Status</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-dark" title="View Dossier">
                                    <i class="fa-solid fa-folder-open"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary" title="Edit Buyer">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-controller="Quotations" asp-action="Create" asp-route-customerId="@c.Id" class="btn btn-outline-warning text-dark" title="Create Quotation">
                                    <i class="fa-solid fa-file-invoice-dollar"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete or archive this buyer?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Delete Buyer">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <div class="small text-muted">Page @curPage of @totalPages</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(curPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(curPage - 1)" asp-route-country="@selectedCountry" asp-route-search="@search">Previous</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == curPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-country="@selectedCountry" asp-route-search="@search">@p</a>
                        </li>
                    }
                    <li class="page-item @(curPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(curPage + 1)" asp-route-country="@selectedCountry" asp-route-search="@search">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
