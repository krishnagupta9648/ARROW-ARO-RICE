@model ARROW_ARO_RICE.Models.Customer
@{
    ViewData["Title"] = $"Edit Buyer - {Model.CompanyName}";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary mb-2">&larr; Back to Buyer Profile</a>
        <h4 class="font-serif text-dark mb-0">Edit Importer: <span class="text-primary">@Model.CompanyName</span></h4>
        <span class="text-muted small">Update buyer trade credentials, VAT IDs, credit terms, and contact points.</span>
    </div>
    <div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete or archive this buyer?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="fa-solid fa-trash me-1"></i> Delete Buyer
            </button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white max-w-800">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label small fw-semibold">Company / Importer Name *</label>
                <input asp-for="CompanyName" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="ContactPerson" class="form-label small fw-semibold">Primary Contact Person *</label>
                <input asp-for="ContactPerson" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label small fw-semibold">Corporate Email *</label>
                <input asp-for="Email" class="form-control" type="email" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label small fw-semibold">Primary Phone *</label>
                <input asp-for="Phone" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="WhatsApp" class="form-label small fw-semibold">WhatsApp Number</label>
                <input asp-for="WhatsApp" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="Country" class="form-label small fw-semibold">Country of Import *</label>
                <input asp-for="Country" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="City" class="form-label small fw-semibold">City</label>
                <input asp-for="City" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="PreferredDestinationPort" class="form-label small fw-semibold">Preferred Discharge Port</label>
                <input asp-for="PreferredDestinationPort" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="TaxOrVatNumber" class="form-label small fw-semibold">Tax / VAT ID</label>
                <input asp-for="TaxOrVatNumber" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="ImportLicenseNumber" class="form-label small fw-semibold">Import License / Customs Code</label>
                <input asp-for="ImportLicenseNumber" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="CreditLimitUsd" class="form-label small fw-semibold">Credit Limit (USD)</label>
                <input asp-for="CreditLimitUsd" class="form-control" type="number" step="1000" />
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label small fw-semibold">Buyer Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Active Buyer">Active Buyer</option>
                    <option value="Prospective Buyer">Prospective Buyer</option>
                    <option value="Credit Approved">Credit Approved</option>
                    <option value="On Hold">On Hold</option>
                    <option value="Archived">Archived</option>
                </select>
            </div>

            <div class="col-12">
                <label asp-for="PaymentTerms" class="form-label small fw-semibold">Agreed Payment Terms</label>
                <input asp-for="PaymentTerms" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label small fw-semibold">Registered Warehouse / Office Address</label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label small fw-semibold">Internal Trade Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12 d-flex justify-content-end gap-2 pt-3">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-emerald px-5">Save Buyer Changes</button>
            </div>
        </div>
    </form>
</div>
