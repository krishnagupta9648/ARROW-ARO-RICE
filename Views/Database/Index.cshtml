@model ARROW_ARO_RICE.Models.DatabaseDashboardViewModel
@{
    ViewData["Title"] = "Database Studio & Architecture";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Database Management</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="fa-solid fa-database text-success me-2"></i> Relational Database Studio & Data Hub
            </h2>
            <p class="text-muted small mb-0">
                Enterprise schema inspection, live table browser, read-only SQL studio, and standalone SQL export scripts.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="DownloadSqlite" class="btn btn-outline-success btn-sm d-flex align-items-center gap-2">
                <i class="fa-solid fa-download"></i> Download SQLite DB (.db)
            </a>
            <a asp-action="DownloadSchema" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2">
                <i class="fa-solid fa-file-code"></i> Download Schema (schema.sql)
            </a>
            <a asp-action="DownloadSeedData" class="btn btn-outline-warning text-dark btn-sm d-flex align-items-center gap-2">
                <i class="fa-solid fa-file-import"></i> Download Seed Data (seed_data.sql)
            </a>
            <button type="button" class="btn btn-dark btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#reseedModal">
                <i class="fa-solid fa-arrows-rotate"></i> Verify / Re-Seed
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="fa-solid fa-circle-check fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-4">
                        <i class="fa-solid fa-server"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Active Engine</div>
                        <h5 class="fw-bold mb-0 text-dark">SQLite 3</h5>
                        <div class="small text-success d-flex align-items-center gap-1 mt-1">
                            <span class="badge bg-success bg-opacity-75">Online & Connected</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-4">
                        <i class="fa-solid fa-table-cells"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Relational Tables</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalTablesCount</h4>
                        <div class="small text-muted mt-1">Fully mapped EF Core entities</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 fs-4">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Total Records</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalRecordsCount.ToString("N0")</h4>
                        <div class="small text-muted mt-1">Realistic trade data points</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 fs-4">
                        <i class="fa-solid fa-hard-drive"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Database Size</div>
                        <h4 class="fw-bold mb-0 text-dark">@((Model.DatabaseFileSizeBytes / 1024.0).ToString("N1")) KB</h4>
                        <div class="small text-muted mt-1">arrow_rice.db on disk</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive SQL Studio Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-dark text-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-terminal text-warning"></i>
                <span class="fw-bold">Interactive Read-Only SQL Studio</span>
                <span class="badge bg-secondary small">Safe Execution</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-light btn-sm" onclick="setQuery('SELECT Code, Name, Category, Variety, DefaultFobPricePerMT, MoistureMaxPercent FROM Products LIMIT 10;')">
                    Products
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="setQuery('SELECT CompanyName, Country, PreferredDestinationPort, PaymentTerms, Status FROM Customers LIMIT 10;')">
                    Buyers
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="setQuery('SELECT ContainerNumber, ShippingLine, VesselName, MilestoneStatus, PortOfDischarge FROM ExportShipments LIMIT 10;')">
                    Shipments
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" onclick="setQuery('SELECT InvoiceNumber, GrandTotal, PaidAmount, Status, DueDate FROM Invoices LIMIT 10;')">
                    Invoices
                </button>
            </div>
        </div>
        <div class="card-body bg-light">
            <form id="sqlForm" class="mb-3">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <textarea id="sqlQueryInput" name="sqlQuery" class="form-control font-monospace" rows="3" 
                              style="background: #1e1e1e; color: #73d216; font-size: 0.9rem;"
                              placeholder="Type a SELECT, PRAGMA, or EXPLAIN query here...">SELECT Code, Name, Category, Variety, DefaultFobPricePerMT, MoistureMaxPercent FROM Products LIMIT 10;</textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i>
                        Safe read-only sandbox. Queries are executed directly against the active database.
                    </span>
                    <button type="button" id="btnRunQuery" class="btn btn-success btn-sm px-3 fw-bold d-flex align-items-center gap-1">
                        <i class="fa-solid fa-play"></i> Run Query
                    </button>
                </div>
            </form>

            <div id="queryResultContainer" style="display: none;">
                <!-- Loaded dynamically via AJAX -->
            </div>
        </div>
    </div>

    <!-- Standalone Scripts & Documentation Cards -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="fa-solid fa-file-code text-primary"></i> Standalone SQL Scripts Repository
                    </h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Production-grade SQL scripts generated and located in the <code>/database</code> directory. Compatible with 
                        <strong>MySQL 8.0+</strong>, <strong>MariaDB</strong>, <strong>PostgreSQL</strong>, <strong>MS SQL Server</strong>, and <strong>SQLite</strong>.
                    </p>
                    <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                        @foreach (var script in Model.ScriptFiles)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="badge bg-dark font-monospace">@script.FileName</span>
                                        <span class="badge bg-light text-muted border ms-1">@((script.FileSizeBytes / 1024.0).ToString("N1")) KB</span>
                                    </div>
                                    <a href="@(script.FileName == "schema.sql" ? Url.Action("DownloadSchema") : Url.Action("DownloadSeedData"))" 
                                       class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.78rem;">
                                        <i class="fa-solid fa-download me-1"></i> Download
                                    </a>
                                </div>
                                <div class="small text-secondary mt-1">@script.Description</div>
                                <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                                    <strong>Supported RDBMS:</strong> @script.SupportedEngines
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="fa-solid fa-plug text-success"></i> Multi-Database Configuration Guide
                    </h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">
                        Switch between SQLite (default zero-config), MySQL (port 3306), or SQL Server by adjusting <code>appsettings.json</code>:
                    </p>

                    <ul class="nav nav-pills nav-fill mb-2" id="dbTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active py-1 small" id="sqlite-tab" data-bs-toggle="tab" data-bs-target="#sqlite-pane">SQLite (Active)</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-1 small" id="mysql-tab" data-bs-toggle="tab" data-bs-target="#mysql-pane">MySQL / MariaDB</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-1 small" id="sqlserver-tab" data-bs-toggle="tab" data-bs-target="#sqlserver-pane">SQL Server</button>
                        </li>
                    </ul>

                    <div class="tab-content border rounded-3 p-3 bg-dark text-light font-monospace small" id="dbTabsContent" style="font-size: 0.8rem;">
                        <div class="tab-pane fade show active" id="sqlite-pane">
                            <span class="text-success">// appsettings.json (Current zero-config setting)</span><br />
                            "ConnectionStrings": {<br />
                            &nbsp;&nbsp;"DefaultConnection": "Data Source=arrow_rice.db"<br />
                            }<br />
                            <span class="text-muted">// Auto-creates & auto-seeds on first application launch.</span>
                        </div>
                        <div class="tab-pane fade" id="mysql-pane">
                            <span class="text-success">// MySQL / phpMyAdmin Setup</span><br />
                            1. Open MySQL Workbench or phpMyAdmin (localhost:3306)<br />
                            2. Execute <code>database/schema.sql</code><br />
                            3. Execute <code>database/seed_data.sql</code><br />
                            4. In <code>appsettings.json</code>:<br />
                            &nbsp;&nbsp;"DefaultConnection": "Server=localhost;Port=3306;Database=arrow_aro_rice;User=root;Password=your_password;"
                        </div>
                        <div class="tab-pane fade" id="sqlserver-pane">
                            <span class="text-success">// Microsoft SQL Server Setup</span><br />
                            1. Open SSMS and create database <code>ArrowAroRiceDb</code><br />
                            2. Execute <code>database/schema.sql</code> & <code>seed_data.sql</code><br />
                            3. In <code>appsettings.json</code>:<br />
                            &nbsp;&nbsp;"DefaultConnection": "Server=localhost;Database=ArrowAroRiceDb;Trusted_Connection=True;TrustServerCertificate=True;"
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Relational Tables Directory -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="fa-solid fa-list-check text-primary"></i> Relational Entities & Tables Directory
                </h5>
                <span class="text-muted small">All 19 structured database tables with schema definitions and direct record viewers</span>
            </div>
            <div class="input-group input-group-sm" style="max-width: 250px;">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" id="tableFilterInput" class="form-control border-start-0" placeholder="Filter tables...">
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablesList">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3 py-3">Table Name</th>
                        <th class="py-3">Module / Category</th>
                        <th class="py-3">Primary Key</th>
                        <th class="py-3 text-center">Row Count</th>
                        <th class="py-3">Entity Description</th>
                        <th class="pe-3 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TableStats)
                    {
                        <tr class="table-row-item">
                            <td class="ps-3 fw-bold text-dark font-monospace">
                                <i class="fa-solid fa-table text-secondary me-1"></i> @t.TableName
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.Category</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-25 text-dark font-monospace">@t.PrimaryKey</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(t.RecordCount > 0 ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2 fw-semibold">
                                    @t.RecordCount.ToString("N0")
                                </span>
                            </td>
                            <td class="text-muted small">
                                @t.Description
                            </td>
                            <td class="pe-3 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Table" asp-route-name="@t.TableName" class="btn btn-outline-primary" title="Browse records in table">
                                        <i class="fa-solid fa-eye me-1"></i> Browse
                                    </a>
                                    <a asp-action="ExportTableCsv" asp-route-name="@t.TableName" class="btn btn-outline-secondary" title="Export this table to CSV">
                                        <i class="fa-solid fa-file-csv"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Re-seed Modal -->
<div class="modal fade" id="reseedModal" tabindex="-1" aria-labelledby="reseedModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ResetDemoData" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="reseedModalLabel">
                        <i class="fa-solid fa-arrows-rotate text-warning me-2"></i> Verify / Re-Seed Database
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-2">
                        This action validates database connectivity and ensures all 19 relational entities and pre-configured international trade data are properly populated.
                    </p>
                    <div class="alert alert-info small mb-0">
                        <i class="fa-solid fa-info-circle me-1"></i>
                        Safe operation: if records already exist, DbInitializer will verify and retain current data integrity.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Confirm Verification</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setQuery(sql) {
            document.getElementById('sqlQueryInput').value = sql;
            runQuery();
        }

        function runQuery() {
            const sql = document.getElementById('sqlQueryInput').value;
            const container = document.getElementById('queryResultContainer');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            container.style.display = 'block';
            container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-success" role="status"></div> Executing SQL query...</div>';

            fetch('@Url.Action("ExecuteQuery", "Database")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    'sqlQuery': sql,
                    '__RequestVerificationToken': token
                })
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
            })
            .catch(err => {
                container.innerHTML = '<div class="alert alert-danger py-2">Error connecting to query engine: ' + err + '</div>';
            });
        }

        document.getElementById('btnRunQuery').addEventListener('click', runQuery);

        // Filter tables list
        document.getElementById('tableFilterInput').addEventListener('keyup', function () {
            const val = this.value.toLowerCase();
            const rows = document.querySelectorAll('#tablesList tbody tr.table-row-item');
            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                r.style.display = text.includes(val) ? '' : 'none';
            });
        });
    </script>
}
