@model List<ARROW_ARO_RICE.Models.SalesOrder>
@{
    ViewData["Title"] = "Sales Orders Management";
    Layout = "_AdminLayout";
    var curStatus = ViewBag.SelectedStatus as string ?? "";
    var search = ViewBag.SearchTerm as string ?? "";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">Confirmed Sales Orders</h5>
            <p class="text-muted small mb-0">Manage export order fulfillment, processing timelines, container allocations, and dispatch milestones.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Quotations" asp-action="Index" class="btn btn-sm btn-gold">
                <i class="fa-solid fa-plus me-1"></i> Convert from Accepted Quote
            </a>
            <a asp-action="PurchaseOrders" class="btn btn-sm btn-outline-dark">
                <i class="fa-solid fa-truck-ramp-box me-1"></i> Farmer POs
            </a>
        </div>
    </div>

    <!-- Filter Form -->
    <form asp-action="Index" method="get" class="row g-2 mt-3 pt-3 border-top">
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Order Statuses</option>
                @foreach (var s in Enum.GetValues<ARROW_ARO_RICE.Models.SalesOrderStatus>())
                {
                    <option value="@s" selected="@(curStatus == s.ToString())">@s</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search by order number, buyer or port..." />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-emerald w-100">Filter</button>
            @if (!string.IsNullOrEmpty(curStatus) || !string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order No</th>
                    <th>Date</th>
                    <th>Buyer</th>
                    <th>Route</th>
                    <th>Volume (MT)</th>
                    <th>Order Value</th>
                    <th>Shipment Status</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No sales orders found matching filters.</td>
                    </tr>
                }
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="fw-bold text-success fs-6">@o.OrderNumber</td>
                        <td>@o.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="fw-bold text-dark">@o.Customer?.CompanyName</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@o.Customer?.Country</div>
                        </td>
                        <td>
                            <span class="text-muted">@o.PortOfLoading</span> &rarr;
                            <strong class="text-dark">@o.PortOfDestination</strong>
                        </td>
                        <td class="fw-bold fs-6 text-dark">@o.TotalQuantityMT.ToString("N1") MT</td>
                        <td class="fw-bold text-success fs-6">$@o.TotalAmount.ToString("N0") <span class="small text-muted">@o.Currency</span></td>
                        <td>
                            @if (o.Shipments.Any())
                            {
                                var sh = o.Shipments.First();
                                <span class="badge-status badge-intransit">@sh.CurrentMilestone</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">No Shipment Yet</span>
                            }
                        </td>
                        <td>
                            <span class="badge-status badge-@o.Status.ToString().ToLower()">
                                @o.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-dark" title="Manage Order">
                                    <i class="fa-solid fa-folder-open"></i> Manage
                                </a>
                                <form asp-action="Delete" asp-route-id="@o.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete or cancel this order?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Delete or Cancel Order">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
