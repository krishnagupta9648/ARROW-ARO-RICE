@model List<ARROW_ARO_RICE.Models.PurchaseOrder>
@{
    ViewData["Title"] = "Procurement & Purchase Orders";
    Layout = "_AdminLayout";
    var suppliers = ViewBag.Suppliers as List<ARROW_ARO_RICE.Models.Supplier> ?? new List<ARROW_ARO_RICE.Models.Supplier>();
    var warehouses = ViewBag.Warehouses as List<ARROW_ARO_RICE.Models.Warehouse> ?? new List<ARROW_ARO_RICE.Models.Warehouse>();
    var products = ViewBag.Products as List<ARROW_ARO_RICE.Models.Product> ?? new List<ARROW_ARO_RICE.Models.Product>();
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">Raw Paddy & Material Procurement</h5>
            <p class="text-muted small mb-0">Track purchase contracts from farmer cooperatives, grain mandis, and packaging sack manufacturers.</p>
        </div>
        <button type="button" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#newPoModal">
            <i class="fa-solid fa-plus"></i> New Purchase Order
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>PO Number</th>
                    <th>Date</th>
                    <th>Supplier / Farmer Coop</th>
                    <th>Variety / Material</th>
                    <th>Warehouse Destination</th>
                    <th>Volume (MT)</th>
                    <th>Rate / MT</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold text-success">@p.PoNumber</td>
                        <td>@p.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="fw-bold text-dark">@p.Supplier?.Name</div>
                            <span class="text-muted" style="font-size: 0.72rem;">@p.Supplier?.SupplierType (@p.Supplier?.Location)</span>
                        </td>
                        <td>@p.Product?.Name</td>
                        <td>@p.Warehouse?.Name</td>
                        <td class="fw-bold fs-6">@p.QuantityMT.ToString("N1") MT</td>
                        <td>$@p.UnitRatePerMT.ToString("N0")</td>
                        <td class="fw-bold text-dark">$@p.TotalAmount.ToString("N0")</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success">@p.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- New Purchase Order Modal -->
<div class="modal fade" id="newPoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white" style="background: linear-gradient(135deg, #091f13, #154e29) !important;">
                <h5 class="modal-title font-serif text-white">Create Procurement Purchase Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreatePurchaseOrder" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Supplier / Farmer Cooperative *</label>
                        <select name="supplierId" class="form-select" required>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id">@s.Name (@s.SupplierType)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Rice Variety / Paddy *</label>
                        <select name="productId" class="form-select" required>
                            @foreach (var prod in products)
                            {
                                <option value="@prod.Id">@prod.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Warehouse *</label>
                        <select name="warehouseId" class="form-select" required>
                            @foreach (var wh in warehouses)
                            {
                                <option value="@wh.Id">@wh.Name (@wh.City)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Quantity (MT) *</label>
                            <input type="number" step="1" name="quantityMT" class="form-control" value="50" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Rate per MT (USD) *</label>
                            <input type="number" step="10" name="unitRate" class="form-control" value="850" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Quality Criteria / Remarks</label>
                        <textarea name="qualityRemarks" class="form-control" rows="2" placeholder="Moisture test <= 12%, raw grain length 8.35mm..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-3">Generate PO</button>
                </div>
            </form>
        </div>
    </div>
</div>
