@model ARROW_ARO_RICE.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "CRM & Business Management Portal Login";
    Layout = "_Layout";
}

<div class="py-5" style="background: linear-gradient(135deg, #091f13, #154e29); min-height: 80vh; display: flex; align-items: center;">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                    <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #0a2916, #124726);">
                        <span class="brand-badge mb-2"><i class="fa-solid fa-wheat-awn"></i> SECURE ERP / CRM</span>
                        <h4 class="font-serif text-white mb-1">ARROW ARO RICE</h4>
                        <p class="text-white-50 small mb-0">Export Management & CRM System</p>
                    </div>

                    <div class="p-4 p-md-5">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <div asp-validation-summary="All" class="text-danger mb-0"></div>
                            </div>
                        }

                        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-semibold">Work Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                                    <input asp-for="Email" id="loginEmail" class="form-control" placeholder="name@arrowarorice.com" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                                    <input asp-for="Password" id="loginPassword" class="form-control" placeholder="••••••••" required />
                                </div>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted">Remember my active session</label>
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-2 fw-bold">
                                <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Access Portal
                            </button>
                        </form>

                        <!-- Demo 1-Click Credentials Helper -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="text-muted small fw-bold text-center mb-2 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Quick Test Login (Demo Role Profiles)</div>
                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                <button type="button" class="btn btn-xs btn-outline-success" onclick="fillCreds('admin@arrowarorice.com', 'Admin@2026#Rice')">
                                    <i class="fa-solid fa-crown me-1 text-warning"></i> Admin
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-primary" onclick="fillCreds('sales@arrowarorice.com', 'Sales@2026#Rice')">
                                    <i class="fa-solid fa-briefcase me-1"></i> Sales
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-dark" onclick="fillCreds('inventory@arrowarorice.com', 'Inventory@2026#Rice')">
                                    <i class="fa-solid fa-boxes-stacked me-1"></i> Inventory
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-warning text-dark" onclick="fillCreds('accounts@arrowarorice.com', 'Accounts@2026#Rice')">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> Accounts
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillCreds(email, pwd) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = pwd;
    }
</script>
}
