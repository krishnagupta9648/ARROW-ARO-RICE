@model ARROW_ARO_RICE.Models.ExportShipment
@{
    ViewData["Title"] = $"Consignment Tracking: {Model.ShipmentNumber}";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">&larr; Back to Shipments</a>
        <h4 class="font-serif text-dark mb-0">Export Shipment #@Model.ShipmentNumber</h4>
        <span class="text-muted small">Sales Order Ref: <strong>@Model.SalesOrder?.OrderNumber</strong> | Consignee: <strong>@Model.SalesOrder?.Customer?.CompanyName</strong></span>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-gold" data-bs-toggle="modal" data-bs-target="#updateMilestoneModal">
            <i class="fa-solid fa-timeline me-1"></i> Update Milestone
        </button>
        <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#addDocumentModal">
            <i class="fa-solid fa-file-circle-plus me-1"></i> Add Export Document
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Milestone Progress Timeline -->
    <div class="col-lg-8">
        <!-- Visual Milestone Timeline Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-route text-success me-2"></i> Export Consignment Journey</h5>
                <span class="badge-status badge-intransit">@Model.CurrentMilestone</span>
            </div>

            <div class="timeline ps-4">
                @{
                    var milestones = Enum.GetValues<ARROW_ARO_RICE.Models.ShipmentMilestone>().ToList();
                    var currentIndex = milestones.IndexOf(Model.CurrentMilestone);
                }

                @for (int i = 0; i < milestones.Count; i++)
                {
                    var m = milestones[i];
                    var isCompleted = i < currentIndex;
                    var isCurrent = i == currentIndex;
                    var cssClass = isCompleted ? "completed" : (isCurrent ? "current" : "");

                    <div class="timeline-step @cssClass">
                        <div class="timeline-dot"></div>
                        <div class="fw-bold @(isCurrent ? "text-success fs-6" : (isCompleted ? "text-dark" : "text-muted"))">
                            @m.ToString()
                            @if (isCurrent)
                            {
                                <span class="badge bg-warning text-dark ms-2">Active Milestone</span>
                            }
                        </div>
                        <div class="small text-muted">
                            @switch (m)
                            {
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.OrderConfirmed:
                                    <span>Contract executed & production schedule confirmed.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.FactoryProcessing:
                                    <span>Raw paddy milling, parboiling, and optical sortex cleaning at Taraori plant.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.PackingCompleted:
                                    <span>Export bag packing (50kg/25kg), batch labeling, and palletizing.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.CfsPortArrival:
                                    <span>Trailer container arrived at Mundra / JNPT port CFS yard.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.CustomsCleared:
                                    <span>Indian Customs export gate pass issued, Shipping Bill filed, and duty cleared.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.VesselDeparted:
                                    <span>Cargo loaded on ocean vessel @Model.VesselName. Departure: @(Model.ActualDeparture?.ToString("dd MMM yyyy") ?? "In progress")</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.InTransit:
                                    <span>Vessel sailing on high-seas toward @Model.PortOfDestination. ETA: @(Model.EstimatedArrival?.ToString("dd MMM yyyy") ?? "Pending")</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.ArrivedDestinationPort:
                                    <span>Container vessel anchored at destination port. Discharging containers.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.CustomsClearedDest:
                                    <span>Import customs clearance & overseas plant quarantine inspection completed.</span>
                                    break;
                                case ARROW_ARO_RICE.Models.ShipmentMilestone.Delivered:
                                    <span>Cargo safely delivered to buyer warehouse. Voyage concluded.</span>
                                    break;
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Statutory Export Documents Manager -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-serif text-dark mb-0"><i class="fa-solid fa-folder-closed text-warning me-2"></i> Statutory Export Document Dossier</h5>
                <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#addDocumentModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Document
                </button>
            </div>

            <p class="text-muted small">Original verified trade certificates for overseas customs clearance and bank Letter of Credit negotiation.</p>

            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Document Title</th>
                            <th>Category</th>
                            <th>Reference No</th>
                            <th>Issuing Authority</th>
                            <th>Issued Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    <i class="fa-solid fa-file-pdf text-danger me-2"></i> @doc.Title
                                    @if (!string.IsNullOrEmpty(doc.Remarks))
                                    {
                                        <div class="text-muted" style="font-size: 0.72rem;">@doc.Remarks</div>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@doc.DocType</span></td>
                                <td class="font-monospace fw-semibold">@doc.DocumentNumber</td>
                                <td class="text-muted">@doc.IssuingAuthority</td>
                                <td class="text-muted">@doc.IssuedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">
                                        <i class="fa-solid fa-check me-1"></i> Verified
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Maritime Specifications Sidecard -->
    <div class="col-lg-4">
        <!-- Maritime Vessel & Carrier Details -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="font-serif text-dark mb-3"><i class="fa-solid fa-ship text-primary me-2"></i> Maritime Carrier Specs</h5>

            <div class="mb-3">
                <div class="text-muted small">Ocean Shipping Line</div>
                <div class="fw-bold fs-6 text-dark">@Model.ShippingLine</div>
                <div class="text-muted small">Booking: <strong>@Model.BookingNumber</strong></div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Mother Vessel & Voyage</div>
                <div class="fw-bold text-dark">@Model.VesselName</div>
                <div class="text-muted small">Voyage No: <strong>@Model.VoyageNumber</strong></div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Bill of Lading (B/L)</div>
                <div class="fw-bold text-success font-monospace">@Model.BillOfLadingNumber</div>
                <div class="text-muted small">Clean on Board 3/3 Originals</div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">Container Numbers (20' FCL)</div>
                <div class="p-2 bg-light rounded font-monospace small fw-semibold text-dark">
                    @Model.ContainerNumbers
                </div>
            </div>

            <div class="mb-3">
                <div class="text-muted small">High Security Seal Numbers</div>
                <div class="p-2 bg-light rounded font-monospace small fw-semibold text-dark">
                    @Model.SealNumbers
                </div>
            </div>

            <div class="pt-3 border-top">
                <div class="small mb-1"><strong>Port of Loading:</strong> @Model.PortOfLoading</div>
                <div class="small"><strong>Destination Port:</strong> <span class="text-success fw-bold">@Model.PortOfDestination</span></div>
            </div>
        </div>

        <!-- Live Radar Status Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #091f13, #154e29);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="font-serif text-white mb-0"><i class="fa-solid fa-satellite-dish text-warning me-1"></i> Live Vessel Radar</h6>
                <span class="badge bg-warning text-dark text-uppercase">Tracking</span>
            </div>
            <p class="small text-white-75 mb-3">@Model.StatusDescription</p>
            @if (!string.IsNullOrEmpty(Model.TrackingNotes))
            {
                <div class="p-3 bg-black bg-opacity-25 rounded small border border-white border-opacity-15 font-monospace" style="font-size: 0.75rem; white-space: pre-wrap;">@Model.TrackingNotes</div>
            }
        </div>
    </div>
</div>

<!-- Modal: Update Milestone -->
<div class="modal fade" id="updateMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white" style="background: linear-gradient(135deg, #091f13, #154e29) !important;">
                <h5 class="modal-title font-serif text-white">Advance Consignment Milestone</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateMilestone" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Milestone *</label>
                        <select name="milestone" class="form-select" required>
                            @foreach (var m in Enum.GetValues<ARROW_ARO_RICE.Models.ShipmentMilestone>())
                            {
                                <option value="@m" selected="@(Model.CurrentMilestone == m)">@m</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Public Status Description *</label>
                        <input type="text" name="statusDescription" class="form-control" value="@Model.StatusDescription" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Radar / Tracking Notes</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Customs seal inspection cleared, vessel departed Mundra..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-3">Update Milestone</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Export Document -->
<div class="modal fade" id="addDocumentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white" style="background: linear-gradient(135deg, #091f13, #154e29) !important;">
                <h5 class="modal-title font-serif text-white">Add Export Document to Dossier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddDocument" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="shipmentId" value="@Model.Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Document Category *</label>
                        <select name="docType" class="form-select" required>
                            @foreach (var dt in Enum.GetValues<ARROW_ARO_RICE.Models.DocumentType>())
                            {
                                <option value="@dt">@dt</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Document Title *</label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. SGS Pre-Shipment Quality Certificate" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Certificate / Document Number *</label>
                        <input type="text" name="documentNumber" class="form-control" placeholder="e.g. SGS-MND-99182" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Issuing Authority</label>
                        <input type="text" name="issuingAuthority" class="form-control" value="SGS India / APEDA / Chamber of Commerce" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Remarks</label>
                        <textarea name="remarks" class="form-control" rows="2" placeholder="Original 3/3 signed copies verified..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-3">Add to Dossier</button>
                </div>
            </form>
        </div>
    </div>
</div>
