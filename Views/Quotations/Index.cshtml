@model List<ARROW_ARO_RICE.Models.Quotation>
@{
    ViewData["Title"] = "Export Quotations (Proforma) Pipeline";
    Layout = "_AdminLayout";
    var curStatus = ViewBag.SelectedStatus as string ?? "";
    var search = ViewBag.SearchTerm as string ?? "";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="font-serif text-dark mb-1">Export Quotations & Proforma Pipeline</h5>
            <p class="text-muted small mb-0">Track commercial offers, freight additions, revision history, and buyer approvals.</p>
        </div>
        <a asp-action="Create" class="btn btn-sm btn-gold d-inline-flex align-items-center gap-1">
            <i class="fa-solid fa-plus"></i> New Export Quotation
        </a>
    </div>

    <!-- Filter Form -->
    <form asp-action="Index" method="get" class="row g-2 mt-3 pt-3 border-top">
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Quotation Statuses</option>
                @foreach (var s in Enum.GetValues<ARROW_ARO_RICE.Models.QuotationStatus>())
                {
                    <option value="@s" selected="@(curStatus == s.ToString())">@s</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search by quote number, buyer, or destination port..." />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-emerald w-100">Filter</button>
            @if (!string.IsNullOrEmpty(curStatus) || !string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Quotations Table -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Quote No</th>
                    <th>Quotation Date</th>
                    <th>Buyer / Company</th>
                    <th>Destination Port</th>
                    <th>Terms</th>
                    <th>Grand Total</th>
                    <th>Valid Until</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No quotations found.</td>
                    </tr>
                }
                @foreach (var q in Model)
                {
                    <tr>
                        <td class="fw-bold text-success">@q.QuotationNumber</td>
                        <td>@q.QuotationDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="fw-bold text-dark">@q.CustomerName</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@q.CustomerCountry</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@q.DestinationPort</span></td>
                        <td><span class="badge bg-secondary">@q.IncoTerm</span></td>
                        <td class="fw-bold fs-6 text-dark">$@q.GrandTotal.ToString("N0") <span class="small text-muted">@q.Currency</span></td>
                        <td class="text-muted">@q.ValidUntil.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge-status badge-@q.Status.ToString().ToLower()">
                                @q.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-outline-dark" title="View Proforma">
                                    <i class="fa-solid fa-file-invoice"></i> Proforma
                                </a>
                                @if (q.Status == ARROW_ARO_RICE.Models.QuotationStatus.Accepted && q.ConvertedSalesOrder == null)
                                {
                                    <form asp-action="ConvertToSalesOrder" asp-route-id="@q.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success" title="Convert to Sales Order">
                                            <i class="fa-solid fa-box-archive"></i>
                                        </button>
                                    </form>
                                }
                                @if (q.ConvertedSalesOrder == null)
                                {
                                    <form asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this quotation?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Quotation">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
